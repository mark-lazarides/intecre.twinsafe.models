<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_SafeFbState" Id="{5d9e015e-1809-5153-8717-63aca5596788}">
    <Declaration><![CDATA[// TwinSAFE function block state codes shared by most FBs (Map State value).
// Error is also the state of a block whose configuration the TwinSAFE Safety Editor refuses (too few
// inputs connected, a required input unwired, an invalid EDM reset time): the block then sets Error,
// diagnostic bit 15 (16#8000), which no TwinSAFE FB uses, and stays in Error through every ErrAck.
// See T_SafeFunctionBlockBase.
{attribute 'qualified_only'}
{attribute 'to_string'}
TYPE
E_SafeFbState :
(
    Undefined := 0,
    Run := 1,
    Stop := 2,
    Safe := 3,
    Error := 4,
    Reset := 5,
    Start := 6,
    ErrorDelay := 7,
    DelayOut := 8
) BYTE;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>