<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_SafeConnShutdownParameters" Id="{779c82ca-f406-54d0-b806-20a656f072c2}">
    <Declaration><![CDATA[// Parameters of FB CONNECTION SHUTDOWN.
TYPE
ST_SafeConnShutdownParameters :
STRUCT
    Deactivate1MakeContact : BOOL;
    Deactivate2MakeContact : BOOL;
    DiscrepancyTime : TIME;
    SafeInputsAfterDiscError : BOOL; // Safety Editor checkbox 'Safe Inputs after Disc Error', FALSE for a new block:
        // TRUE makes both channels of the pair that raised a discrepancy error return to the safe state together
        // before ErrAck can clear it
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>