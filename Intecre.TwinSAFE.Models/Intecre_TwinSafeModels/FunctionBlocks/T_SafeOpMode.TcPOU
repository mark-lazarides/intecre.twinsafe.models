<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeOpMode" Id="{98341685-b519-5070-8aa5-587674913588}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB OPMODE (operating mode selector).
// Exactly one connected OpIn input must be TRUE for the matching OpOut to be set.
// Manual restart is active when the Restart port is connected.
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeOpMode EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    Restart : BOOL; // may be a standard PLC signal
    OpIn1 : BOOL;
    OpIn2 : BOOL;
    OpIn3 : BOOL;
    OpIn4 : BOOL;
    OpIn5 : BOOL;
    OpIn6 : BOOL;
    OpIn7 : BOOL;
    OpIn8 : BOOL;
    Parameters : ST_SafeOpModeParameters;
END_VAR
VAR_OUTPUT
    OpOut1 : BOOL;
    OpOut2 : BOOL;
    OpOut3 : BOOL;
    OpOut4 : BOOL;
    OpOut5 : BOOL;
    OpOut6 : BOOL;
    OpOut7 : BOOL;
    OpOut8 : BOOL;
END_VAR
VAR
    {attribute 'is_connected' := 'Restart'}
    _restartConnected : BOOL;
    {attribute 'is_connected' := 'OpIn1'}
    _opIn1Connected : BOOL;
    {attribute 'is_connected' := 'OpIn2'}
    _opIn2Connected : BOOL;
    {attribute 'is_connected' := 'OpIn3'}
    _opIn3Connected : BOOL;
    {attribute 'is_connected' := 'OpIn4'}
    _opIn4Connected : BOOL;
    {attribute 'is_connected' := 'OpIn5'}
    _opIn5Connected : BOOL;
    {attribute 'is_connected' := 'OpIn6'}
    _opIn6Connected : BOOL;
    {attribute 'is_connected' := 'OpIn7'}
    _opIn7Connected : BOOL;
    {attribute 'is_connected' := 'OpIn8'}
    _opIn8Connected : BOOL;
    _state : E_SafeFbState := E_SafeFbState.Stop;
    _prevState : E_SafeFbState;
    _restartPrev : BOOL;
    _discrepancyTimer : TON;
    _modeSelectedBefore : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{33fa2768-1569-5fef-9991-8b2fdfcd3ef0}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    count : USINT;
    selected : USINT;
    exactlyOne : BOOL;
    restartFalling : BOOL;
    monitoring : BOOL;
    operating : BOOL;
    stateBefore : E_SafeFbState;
    passes : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _opIn1Connected AND OpIn1 THEN
    count    := count + 1;
    selected := 1;
END_IF

IF _opIn2Connected AND OpIn2 THEN
    count    := count + 1;
    selected := 2;
END_IF

IF _opIn3Connected AND OpIn3 THEN
    count    := count + 1;
    selected := 3;
END_IF

IF _opIn4Connected AND OpIn4 THEN
    count    := count + 1;
    selected := 4;
END_IF

IF _opIn5Connected AND OpIn5 THEN
    count    := count + 1;
    selected := 5;
END_IF

IF _opIn6Connected AND OpIn6 THEN
    count    := count + 1;
    selected := 6;
END_IF

IF _opIn7Connected AND OpIn7 THEN
    count    := count + 1;
    selected := 7;
END_IF

IF _opIn8Connected AND OpIn8 THEN
    count    := count + 1;
    selected := 8;
END_IF

exactlyOne     := (count = 1);
restartFalling := NOT Restart AND _restartPrev;
_restartPrev   := Restart;

IF NOT _fbRun AND _state <> E_SafeFbState.Error AND _state <> E_SafeFbState.Reset THEN
    _state := E_SafeFbState.Stop;
END_IF

// Discrepancy monitoring of a mode change: none or several inputs set for too long
operating  := (_state = E_SafeFbState.Safe) OR (_state = E_SafeFbState.Start) OR (_state = E_SafeFbState.Run);
monitoring := operating AND _modeSelectedBefore AND NOT exactlyOne AND (Parameters.DiscrepancyTime > T#0S);
_discrepancyTimer(IN := monitoring, PT := Parameters.DiscrepancyTime);

IF _discrepancyTimer.Q AND operating THEN
    SetDiagBit(0);
    _state := E_SafeFbState.Error;
END_IF

passes := 0;

REPEAT
    stateBefore := _state;

    CASE _state OF
        E_SafeFbState.Stop:
            IF StateChanged() THEN
                SetOutputs(0);
                Error               := FALSE;
                Diag                := 0;
                _modeSelectedBefore := FALSE;
            END_IF

            IF _fbRun THEN
                _state := E_SafeFbState.Safe;
            END_IF

        E_SafeFbState.Safe:
            IF StateChanged() THEN
                SetOutputs(0);
            END_IF

            IF exactlyOne THEN
                IF NOT _restartConnected THEN
                    _state := E_SafeFbState.Run;
                ELSIF Restart THEN
                    _state := E_SafeFbState.Start;
                END_IF
            END_IF

        E_SafeFbState.Start:
            IF StateChanged() THEN
                SetOutputs(0);
            END_IF

            IF NOT exactlyOne THEN
                _state := E_SafeFbState.Safe;
            ELSIF restartFalling THEN
                _state := E_SafeFbState.Run;
            END_IF

        E_SafeFbState.Run:
            IF StateChanged() THEN
                _modeSelectedBefore := TRUE;
            END_IF

            IF exactlyOne THEN
                SetOutputs(selected);
            ELSE
                SetOutputs(0);
                _state := E_SafeFbState.Safe;
            END_IF

        E_SafeFbState.Error:
            IF StateChanged() THEN
                SetOutputs(0);
                Error := TRUE;
            END_IF

            IF _errAck THEN
                _state := E_SafeFbState.Reset;
            END_IF

        E_SafeFbState.Reset:
            IF StateChanged() THEN
                Error := FALSE;
                Diag  := 0;
            END_IF

            IF _errAckFallingEdge THEN
                _state := SEL(_fbRun, E_SafeFbState.Stop, E_SafeFbState.Safe);
            END_IF
    END_CASE

    passes := passes + 1;
UNTIL (stateBefore = _state) OR (passes >= 3)
END_REPEAT

State := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOutputs" Id="{05f7ca13-de6c-5190-862f-ac15b9834e1e}">
      <Declaration><![CDATA[METHOD PRIVATE SetOutputs
VAR_INPUT
    selected : USINT; // 0 = all outputs off
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[OpOut1 := (selected = 1);
OpOut2 := (selected = 2);
OpOut3 := (selected = 3);
OpOut4 := (selected = 4);
OpOut5 := (selected = 5);
OpOut6 := (selected = 6);
OpOut7 := (selected = 7);
OpOut8 := (selected = 8);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateChanged" Id="{daf7f766-f6c9-5d7a-a6df-87b175b137b5}">
      <Declaration><![CDATA[METHOD PRIVATE StateChanged : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _prevState = _state THEN
    RETURN;
END_IF

_prevState   := _state;
StateChanged := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>