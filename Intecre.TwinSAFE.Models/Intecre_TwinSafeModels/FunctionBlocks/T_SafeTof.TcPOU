<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeTof" Id="{4c8768c1-feaa-57e6-8bc9-bead84a7560f}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB TOF (switch-off delay).
// The Safety Editor refuses a TOF with TofIn1 unconnected: the model then reports Error with diagnostic
// bit 15 instead of running (see T_SafeFunctionBlockBase).
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeTof EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    TofIn1 : BOOL;
    Parameters : ST_SafeTimerParameters;
END_VAR
VAR_OUTPUT
    TofOut : BOOL;
END_VAR
VAR
    {attribute 'is_connected' := 'TofIn1'}
    _tofIn1Connected : BOOL;
    _state : E_SafeFbState := E_SafeFbState.Stop;
    _timer : TOF;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="ConfigurationOk" Id="{495cf629-c613-4068-9cb6-e2c85adff886}">
      <Declaration><![CDATA[// TofIn1 must be connected (Safety Editor: "Inport TofIn1 of TOF must be connected").
METHOD PROTECTED ConfigurationOk : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _tofIn1Connected THEN
    _configurationFault := 'T_SafeTof: Inport TofIn1 of TOF must be connected';
    RETURN;
END_IF

ConfigurationOk := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Process" Id="{2251cce6-3005-5361-995b-d7a121020ce4}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    inputActive : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[inputActive := F_SafeInputValue(_tofIn1Connected, Parameters.MakeContact, TofIn1);

IF NOT _fbRun THEN
    // a stopped FB does not run its delay
    _timer(IN := FALSE, PT := T#0S);
    _state := E_SafeFbState.Stop;
ELSE
    _timer(IN := inputActive, PT := Parameters.DelayTime);

    IF inputActive THEN
        _state := E_SafeFbState.Run;
    ELSIF _timer.Q THEN
        _state := E_SafeFbState.DelayOut;
    ELSE
        _state := E_SafeFbState.Safe;
    END_IF
END_IF

TofOut := (_state = E_SafeFbState.Run) OR (_state = E_SafeFbState.DelayOut);
Error  := FALSE;
Diag   := 0;
State  := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>