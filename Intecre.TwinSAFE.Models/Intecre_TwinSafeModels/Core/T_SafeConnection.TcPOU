<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeConnection" Id="{8e676f8a-b719-5557-a4e1-a3fef2dfcee6}" SpecialFunc="None">
    <Declaration><![CDATA[// Simulated TwinSAFE (FSoE) connection between the logic and a safe I/O terminal or another logic.
// Belongs to a group from construction:  conn : T_SafeConnection(group := safetyGroup);
// Starts up through Reset -> Session -> Connection -> Parameter -> Data once the group runs.
// Communication errors are injected with InjectComError and cleared by the group ErrAck
// (plus ComErrAck when ComErrAckActive is set).
FUNCTION_BLOCK T_SafeConnection
VAR_INPUT
    ComErrAck : BOOL; // connection specific acknowledgement (EL6910 option ComErrAckActive)
    LocalShutdown : BOOL; // shutdown requested by FB CONNECTION SHUTDOWN (set through its reference)
    PartnerShutdown : BOOL; // simulates a shutdown command received from the FSoE partner
    InjectComError : BOOL; // rising edge simulates an FSoE communication error
    InjectErrorCode : E_SafeConnectionError := E_SafeConnectionError.WatchdogElapsed;
    StartupTime : TIME := T#300MS; // simulated time from Reset to Data
    ComErrAckActive : BOOL; // connection needs its own ComErrAck in addition to the group ErrAck
END_VAR
VAR_OUTPUT
    ComError : BOOL;
    InStartup : BOOL;
    InDataState : BOOL;
    IsShutdown : BOOL;
    State : BYTE; // connection state code 100..106
    Diag : BYTE; // connection diagnostic byte
END_VAR
VAR
    _group : REFERENCE TO T_SafeGroup;
    _state : E_SafeConnectionState := E_SafeConnectionState.Reset;
    _prevState : E_SafeConnectionState;
    _errorCode : E_SafeConnectionError;
    _groupAcknowledged : BOOL;
    _comErrAcked : BOOL;
    _errAckPrev : BOOL;
    _comErrAckPrev : BOOL;
    _injectPrev : BOOL;
    _startupTimer : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF _group.ErrAck AND NOT _errAckPrev THEN
    _groupAcknowledged := TRUE;
END_IF

_errAckPrev := _group.ErrAck;

IF ComErrAck AND NOT _comErrAckPrev THEN
    _comErrAcked := TRUE;
END_IF

_comErrAckPrev := ComErrAck;

IF InjectComError AND NOT _injectPrev THEN
    ComError           := TRUE;
    _errorCode         := InjectErrorCode;
    _groupAcknowledged := FALSE;
    _comErrAcked       := FALSE;
    _state             := E_SafeConnectionState.Reset;
END_IF

_injectPrev := InjectComError;

// A communication error is cleared once the group (and if required the connection) has acknowledged.
IF ComError AND _groupAcknowledged AND (NOT ComErrAckActive OR _comErrAcked) THEN
    ComError           := FALSE;
    _errorCode         := E_SafeConnectionError.NoError;
    _groupAcknowledged := FALSE;
    _comErrAcked       := FALSE;
END_IF

RunStateMachine();

InStartup := NOT ComError
                 AND (_state = E_SafeConnectionState.Reset
                 OR _state = E_SafeConnectionState.Session
                 OR _state = E_SafeConnectionState.Connection
                 OR _state = E_SafeConnectionState.Parameter);

InDataState := (_state = E_SafeConnectionState.Data);
IsShutdown  := (_state = E_SafeConnectionState.Shutdown) OR (_state = E_SafeConnectionState.ShutdownDeactive);
State       := TO_BYTE(_state);
Diag        := TO_BYTE(_errorCode);

IF InStartup THEN
    Diag := Diag OR 16#40;
END_IF

IF ComError THEN
    Diag := Diag OR 16#10;
END_IF
]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{bd7b55da-20a7-5ca6-b7dc-f857fb536165}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
    group : REFERENCE TO T_SafeGroup; // the TwinSAFE group this connection is assigned to
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_group REF= group;

IF NOT bInCopyCode THEN
    group.RegisterConnection(THIS^);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunStateMachine" Id="{0db52da1-ca25-5b1e-9bfb-0c9bd015f3c5}">
      <Declaration><![CDATA[METHOD PRIVATE RunStateMachine
VAR
    stepTime : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stepTime := UDINT_TO_TIME(TIME_TO_UDINT(StartupTime) / 3);

CASE _state OF
    E_SafeConnectionState.Reset:
        IF StateChanged() THEN
            _startupTimer(IN := FALSE, PT := stepTime);
        END_IF

        IF _group.Run AND NOT ComError THEN
            _state := E_SafeConnectionState.Session;
        END_IF

    E_SafeConnectionState.Session:
        IF StateChanged() THEN
            _startupTimer(IN := FALSE, PT := stepTime);
        END_IF

        _startupTimer(IN := TRUE, PT := stepTime);

        IF _startupTimer.Q THEN
            _state := E_SafeConnectionState.Connection;
        END_IF

    E_SafeConnectionState.Connection:
        IF StateChanged() THEN
            _startupTimer(IN := FALSE, PT := stepTime);
        END_IF

        _startupTimer(IN := TRUE, PT := stepTime);

        IF _startupTimer.Q THEN
            _state := E_SafeConnectionState.Parameter;
        END_IF

    E_SafeConnectionState.Parameter:
        IF StateChanged() THEN
            _startupTimer(IN := FALSE, PT := stepTime);
        END_IF

        _startupTimer(IN := TRUE, PT := stepTime);

        IF _startupTimer.Q THEN
            _state := E_SafeConnectionState.Data;
        END_IF

    E_SafeConnectionState.Data:
        StateChanged();

        IF LocalShutdown THEN
            _state := E_SafeConnectionState.ShutdownDeactive;
        ELSIF PartnerShutdown THEN
            _state := E_SafeConnectionState.Shutdown;
        END_IF

    E_SafeConnectionState.Shutdown:
        StateChanged();

        IF NOT PartnerShutdown THEN
            _state := E_SafeConnectionState.Reset;
        END_IF

    E_SafeConnectionState.ShutdownDeactive:
        StateChanged();

        IF NOT LocalShutdown THEN
            _state := E_SafeConnectionState.Reset;
        END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateChanged" Id="{6c12d6f5-6653-5035-ad81-7f81c1e186a6}">
      <Declaration><![CDATA[METHOD PRIVATE StateChanged : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _prevState = _state THEN
    RETURN;
END_IF

_prevState   := _state;
StateChanged := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>