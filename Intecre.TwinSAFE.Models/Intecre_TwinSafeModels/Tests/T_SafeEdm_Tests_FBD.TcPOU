<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeEdm_Tests_FBD" Id="{002e8693-bb4f-5919-8881-9d4f28c62b58}" SpecialFunc="None">
    <Declaration><![CDATA[// FBD twin of T_SafeEdm_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeEdm_Tests_FBD EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_SwitchOnTimeoutGivesError
    group_1 : T_SafeGroup;
    fb_1 : T_SafeEdm(group := group_1) := (Parameters := (SwitchOnTime := T#100MS));
    t1_1 : TON;
    trig1_1 : R_TRIG;
    // Test_NoErrorWhenFeedbackFollows
    group_2 : T_SafeGroup;
    fb_2 : T_SafeEdm(group := group_2) := (Parameters := (SwitchOnTime := T#100MS, SwitchOffTime := T#100MS));
    t1_2 : TON;
    t2_2 : TON;
    trig1_2 : R_TRIG;
    trig2_2 : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_SwitchOnTimeoutGivesError();
Test_NoErrorWhenFeedbackFollows();
]]></ST>
    </Implementation>
