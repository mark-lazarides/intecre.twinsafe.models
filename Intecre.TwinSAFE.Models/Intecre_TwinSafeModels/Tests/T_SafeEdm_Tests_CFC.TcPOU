  <POU Name="T_SafeEdm_Tests_CFC" Id="{8b16f178-cc2a-5f1f-a536-cb9a23f0b9b3}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeEdm_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeEdm_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_SwitchOnTimeoutGivesError
    group_1 : T_SafeGroup;
    fb_1 : T_SafeEdm(group := group_1) := (Parameters := (SwitchOnTime := T#100MS));
    t1_1 : TON;
    trig1_1 : R_TRIG;
    // Test_NoErrorWhenFeedbackFollows
    group_2 : T_SafeGroup;
    fb_2 : T_SafeEdm(group := group_2) := (Parameters := (SwitchOnTime := T#100MS, SwitchOffTime := T#100MS));
    t1_2 : TON;
    t2_2 : TON;
    trig1_2 : R_TRIG;
    trig2_2 : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_SwitchOnTimeoutGivesError();
Test_NoErrorWhenFeedbackFollows();
]]></ST>
    </Implementation>
