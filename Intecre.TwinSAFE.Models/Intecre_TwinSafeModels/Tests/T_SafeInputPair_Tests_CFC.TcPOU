  <POU Name="T_SafeInputPair_Tests_CFC" Id="{cc86fd5c-5f7c-5925-9bca-64feebc6c714}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeInputPair_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeInputPair_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_InactivePairNeverRequestsSafeState
    pair_1 : T_SafeInputPair;
    // Test_BreakContactRequestsSafeStateOnZero
    pair_2 : T_SafeInputPair;
    // Test_MakeContactRequestsSafeStateOnOne
    pair_3 : T_SafeInputPair;
    // Test_TwoChannelRequestsSafeStateIfEitherChannelLow
    pair_4 : T_SafeInputPair;
    // Test_DiscrepancyErrorAfterTimeoutAndResetAfterSafeInputs
    pair_5 : T_SafeInputPair;
    t1_5 : TON;
    t2_5 : TON;
    trig1_5 : R_TRIG;
    trig2_5 : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_InactivePairNeverRequestsSafeState();
Test_BreakContactRequestsSafeStateOnZero();
Test_MakeContactRequestsSafeStateOnOne();
Test_TwoChannelRequestsSafeStateIfEitherChannelLow();
Test_DiscrepancyErrorAfterTimeoutAndResetAfterSafeInputs();
]]></ST>
    </Implementation>
