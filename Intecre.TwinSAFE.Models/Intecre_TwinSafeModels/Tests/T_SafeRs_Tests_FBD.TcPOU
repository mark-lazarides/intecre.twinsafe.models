    <Declaration><![CDATA[// FBD twin of T_SafeRs_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeRs_Tests_FBD EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_ResetDominantLatch
    group_1 : T_SafeGroup;
    fb_1 : T_SafeRs(group := group_1);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_ResetDominantLatch();
]]></ST>
    </Implementation>
