<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeOpMode_Tests" Id="{d0130fc1-9d06-5052-9dad-6e22ca0784de}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeOpMode_Tests EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_ExactlyOneInputSelectsOutput
    group_1 : T_SafeGroup;
    fb_1 : T_SafeOpMode(group := group_1);
    // Test_ConnectedRestartRequiresRestartSequence
    group_2 : T_SafeGroup;
    fb_2 : T_SafeOpMode(group := group_2);
    // Test_SlowModeChangeGivesDiscrepancyError
    group_3 : T_SafeGroup;
    fb_3 : T_SafeOpMode(group := group_3) := (Parameters := (DiscrepancyTime := T#100MS));
    state_3 : INT := 10;
    waitTimer_3 : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_ExactlyOneInputSelectsOutput();
Test_ConnectedRestartRequiresRestartSequence();
Test_SlowModeChangeGivesDiscrepancyError();
]]></ST>
    </Implementation>
    <Method Name="Test_ConnectedRestartRequiresRestartSequence" Id="{f740a1ec-4a81-5461-a63f-89e5adc985f1}">
      <Declaration><![CDATA[METHOD PRIVATE Test_ConnectedRestartRequiresRestartSequence
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act
group_2(Run := TRUE);
fb_2(Restart := FALSE, OpIn1 := TRUE, OpIn2 := FALSE);
group_2(Run := TRUE);
fb_2(Restart := FALSE, OpIn1 := TRUE, OpIn2 := FALSE);
// assert
AssertEquals_BOOL(Expected := FALSE, Actual := fb_2.OpOut1, Message := 'no output before restart');
group_2(Run := TRUE);
fb_2(Restart := TRUE, OpIn1 := TRUE, OpIn2 := FALSE);
AssertEquals_BYTE(Expected := TO_BYTE(E_SafeFbState.Start), Actual := fb_2.State, Message := 'state START while restart held');
group_2(Run := TRUE);
fb_2(Restart := FALSE, OpIn1 := TRUE, OpIn2 := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fb_2.OpOut1, Message := 'output on after restart falling edge');
TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_ExactlyOneInputSelectsOutput" Id="{3b990399-42cf-5606-b314-eec448d34948}">
      <Declaration><![CDATA[METHOD PRIVATE Test_ExactlyOneInputSelectsOutput
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act: STOP -> SAFE -> RUN (no Restart connected: automatic)
group_1(Run := TRUE);
fb_1(OpIn1 := FALSE, OpIn2 := TRUE);
group_1(Run := TRUE);
fb_1(OpIn1 := FALSE, OpIn2 := TRUE);
// assert
AssertEquals_BOOL(Expected := TRUE, Actual := fb_1.OpOut2, Message := 'selected mode output on');
AssertEquals_BOOL(Expected := FALSE, Actual := fb_1.OpOut1, Message := 'other outputs off');
AssertEquals_BYTE(Expected := TO_BYTE(E_SafeFbState.Run), Actual := fb_1.State, Message := 'state RUN');
// act: second input also set
group_1(Run := TRUE);
fb_1(OpIn1 := TRUE, OpIn2 := TRUE);
AssertEquals_BOOL(Expected := FALSE, Actual := fb_1.OpOut2, Message := 'all outputs off with two modes selected');
AssertEquals_BYTE(Expected := TO_BYTE(E_SafeFbState.Safe), Actual := fb_1.State, Message := 'state SAFE');
TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_SlowModeChangeGivesDiscrepancyError" Id="{77cb4e41-82ca-565a-b75f-291378702b4f}">
      <Declaration><![CDATA[METHOD PRIVATE Test_SlowModeChangeGivesDiscrepancyError
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
waitTimer_3();

CASE state_3 OF
    10:
        // arrange: mode 1 selected and running
        group_3(Run := TRUE);
        fb_3(OpIn1 := TRUE, OpIn2 := FALSE);
        group_3(Run := TRUE);
        fb_3(OpIn1 := TRUE, OpIn2 := FALSE);
        state_3 := 20;
        waitTimer_3(IN := TRUE, PT := T#250MS);
    20:
        // act: leave mode 1 without selecting another
        group_3(Run := TRUE);
        fb_3(OpIn1 := FALSE, OpIn2 := FALSE);

        IF NOT waitTimer_3.Q THEN
            RETURN;
        END_IF

        waitTimer_3(IN := FALSE);
        // assert
        AssertEquals_BOOL(Expected := TRUE, Actual := fb_3.Error, Message := 'discrepancy error after time without a mode');
        AssertEquals_BYTE(Expected := TO_BYTE(E_SafeFbState.Error), Actual := fb_3.State, Message := 'state ERROR');
        AssertEquals_WORD(Expected := WORD#1, Actual := fb_3.Diag, Message := 'diag bit 0');
        TEST_FINISHED_NAMED(__POUNAME());
        state_3 := 10;
END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>