<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeMon_Tests_CFC" Id="{1d89c49f-59ee-5dfb-afa3-1bcdb112e803}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeMon_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeMon_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_AutomaticRestartWhenGuardClosed
    group_1 : T_SafeGroup;
    fb_1 : T_SafeMon(group := group_1);
    // Test_SecureInputBypassesGuard
    group_2 : T_SafeGroup;
    fb_2 : T_SafeMon(group := group_2);
    // Test_ManualFunctionTestRequiresGuardOpenedOnce
    group_3 : T_SafeGroup;
    fb_3 : T_SafeMon(group := group_3) := (Parameters := (ManualFunctionTest := TRUE));
    // Test_EdmFaultWithoutManualRestartStaysSafe
    group_4 : T_SafeGroup;
    fb_4 : T_SafeMon(group := group_4);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_AutomaticRestartWhenGuardClosed();
Test_SecureInputBypassesGuard();
Test_ManualFunctionTestRequiresGuardOpenedOnce();
Test_EdmFaultWithoutManualRestartStaysSafe();
]]></ST>
    </Implementation>
