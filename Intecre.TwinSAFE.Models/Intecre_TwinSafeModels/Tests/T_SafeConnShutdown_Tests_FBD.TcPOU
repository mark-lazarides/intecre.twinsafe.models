  <POU Name="T_SafeConnShutdown_Tests_FBD" Id="{c794a1a8-6a2b-5c8d-95b8-c5881707fe77}" SpecialFunc="None">
    <Declaration><![CDATA[// FBD twin of T_SafeConnShutdown_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeConnShutdown_Tests_FBD EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_DeactivateShutsDownConnection
    group_1 : T_SafeGroup;
    conn_1 : T_SafeConnection(group := group_1);
    fb_1 : T_SafeConnShutdown(group := group_1, connection := conn_1);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_DeactivateShutsDownConnection();
]]></ST>
    </Implementation>
