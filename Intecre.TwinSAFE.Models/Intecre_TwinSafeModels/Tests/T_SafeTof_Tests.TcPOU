<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeTof_Tests" Id="{978229da-758b-5bed-80ea-cf07aeecdce2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeTof_Tests EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_OutputDelayedOff
    group_1 : T_SafeGroup;
    fb_1 : T_SafeTof(group := group_1) := (Parameters := (DelayTime := T#100MS));
    state_1 : INT := 10;
    waitTimer_1 : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_OutputDelayedOff();
]]></ST>
    </Implementation>
    <Method Name="Test_OutputDelayedOff" Id="{b6d59bd9-12c1-5814-8994-2d4710fe2757}">
      <Declaration><![CDATA[METHOD PRIVATE Test_OutputDelayedOff
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
waitTimer_1();

CASE state_1 OF
    10:
        group_1(Run := TRUE);
        fb_1(TofIn1 := TRUE);
        AssertEquals_BOOL(Expected := TRUE, Actual := fb_1.TofOut, Message := 'output on immediately');
        // act
        fb_1(TofIn1 := FALSE);
        AssertEquals_BOOL(Expected := TRUE, Actual := fb_1.TofOut, Message := 'output held during the delay');
        AssertEquals_BYTE(Expected := TO_BYTE(E_SafeFbState.DelayOut), Actual := fb_1.State, Message := 'state DELAYOUT');
        state_1 := 20;
        waitTimer_1(IN := TRUE, PT := T#200MS);
    20:
        group_1(Run := TRUE);
        fb_1(TofIn1 := FALSE);

        IF NOT waitTimer_1.Q THEN
            RETURN;
        END_IF

        waitTimer_1(IN := FALSE);
        // assert
        AssertEquals_BOOL(Expected := FALSE, Actual := fb_1.TofOut, Message := 'output off after the delay');
        TEST_FINISHED_NAMED(__POUNAME());
        state_1 := 10;
END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>