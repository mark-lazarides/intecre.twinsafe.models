<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeInputPair_Tests" Id="{bcf4e6f9-d5f9-570c-bd5c-c378ce895dd6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeInputPair_Tests EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_DiscrepancyErrorAfterTimeoutAndResetAfterSafeInputs
    pair_5 : T_SafeInputPair;
    state_5 : INT := 10;
    waitTimer_5 : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_InactivePairNeverRequestsSafeState();
Test_BreakContactRequestsSafeStateOnZero();
Test_MakeContactRequestsSafeStateOnOne();
Test_TwoChannelRequestsSafeStateIfEitherChannelLow();
Test_DiscrepancyErrorAfterTimeoutAndResetAfterSafeInputs();
]]></ST>
    </Implementation>
    <Method Name="Test_BreakContactRequestsSafeStateOnZero" Id="{860a994d-70b3-5e5c-be74-6e3951fc18e0}">
      <Declaration><![CDATA[METHOD PRIVATE Test_BreakContactRequestsSafeStateOnZero
VAR
    pair : T_SafeInputPair;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act
pair(In1 := FALSE, Active1 := TRUE, Monitor := TRUE);
// assert
AssertEquals_BOOL(Expected := TRUE, Actual := pair.SafeStateRequested, Message := 'break contact at 0 must request the safe state');
pair(In1 := TRUE, Active1 := TRUE, Monitor := TRUE);
AssertEquals_BOOL(Expected := FALSE, Actual := pair.SafeStateRequested, Message := 'break contact at 1 must not request the safe state');
TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_DiscrepancyErrorAfterTimeoutAndResetAfterSafeInputs" Id="{dd76ced7-ac91-549b-a1d2-dae5485b4abf}">
      <Declaration><![CDATA[METHOD PRIVATE Test_DiscrepancyErrorAfterTimeoutAndResetAfterSafeInputs
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
waitTimer_5();

CASE state_5 OF
    10:
        // arrange
        state_5 := 20;
        waitTimer_5(IN := TRUE, PT := T#50MS);
    20:
        // act: channels disagree for less than the discrepancy time
        pair_5(
            In1 := TRUE,
            In2 := FALSE,
            Active1 := TRUE,
            Active2 := TRUE,
            Monitor := TRUE,
            SafeInputsAfterDiscError := TRUE,
            DiscrepancyTime := T#100MS
        );

        IF NOT waitTimer_5.Q THEN
            RETURN;
        END_IF

        waitTimer_5(IN := FALSE);
        // assert
        AssertEquals_BOOL(Expected := FALSE, Actual := pair_5.DiscrepancyError, Message := 'no error before the discrepancy time');
        state_5 := 30;
        waitTimer_5(IN := TRUE, PT := T#200MS);
    30:
        pair_5(
            In1 := TRUE,
            In2 := FALSE,
            Active1 := TRUE,
            Active2 := TRUE,
            Monitor := TRUE,
            SafeInputsAfterDiscError := TRUE,
            DiscrepancyTime := T#100MS
        );

        IF NOT waitTimer_5.Q THEN
            RETURN;
        END_IF

        waitTimer_5(IN := FALSE);
        // assert
        AssertEquals_BOOL(Expected := TRUE, Actual := pair_5.DiscrepancyError, Message := 'error after the discrepancy time');
        AssertEquals_BOOL(Expected := TRUE, Actual := pair_5.AwaitingSafeInputs, Message := 'error waits for both channels safe');
        // act: acknowledge while a channel is still high
        pair_5(
            In1 := TRUE,
            In2 := FALSE,
            Active1 := TRUE,
            Active2 := TRUE,
            Monitor := TRUE,
            SafeInputsAfterDiscError := TRUE,
            DiscrepancyTime := T#100MS,
            Acknowledge := TRUE
        );

        AssertEquals_BOOL(Expected := TRUE, Actual := pair_5.DiscrepancyError, Message := 'acknowledge refused while a channel is still high');
        // act: both channels safe, then acknowledge
        pair_5(
            In1 := FALSE,
            In2 := FALSE,
            Active1 := TRUE,
            Active2 := TRUE,
            Monitor := TRUE,
            SafeInputsAfterDiscError := TRUE,
            DiscrepancyTime := T#100MS,
            Acknowledge := TRUE
        );

        AssertEquals_BOOL(Expected := FALSE, Actual := pair_5.DiscrepancyError, Message := 'error cleared once both channels were safe');
        TEST_FINISHED_NAMED(__POUNAME());
        state_5 := 10;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_InactivePairNeverRequestsSafeState" Id="{5cc6f535-b6a2-54f1-a2e7-5d84e1639c2b}">
      <Declaration><![CDATA[METHOD PRIVATE Test_InactivePairNeverRequestsSafeState
VAR
    pair : T_SafeInputPair;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act
pair(In1 := FALSE, In2 := FALSE, Active1 := FALSE, Active2 := FALSE, Monitor := TRUE);
// assert
AssertEquals_BOOL(Expected := FALSE, Actual := pair.SafeStateRequested, Message := 'inactive pair must not request the safe state');
AssertEquals_BOOL(Expected := FALSE, Actual := pair.IsActive, Message := 'pair should be inactive');
TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_MakeContactRequestsSafeStateOnOne" Id="{facee937-e203-575a-97c0-dcbb95787004}">
      <Declaration><![CDATA[METHOD PRIVATE Test_MakeContactRequestsSafeStateOnOne
VAR
    pair : T_SafeInputPair;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act
pair(In1 := TRUE, Active1 := TRUE, MakeContact1 := TRUE, Monitor := TRUE);
// assert
AssertEquals_BOOL(Expected := TRUE, Actual := pair.SafeStateRequested, Message := 'make contact at 1 must request the safe state');
TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_TwoChannelRequestsSafeStateIfEitherChannelLow" Id="{389619fb-993a-5724-aab9-3880d5c58d77}">
      <Declaration><![CDATA[METHOD PRIVATE Test_TwoChannelRequestsSafeStateIfEitherChannelLow
VAR
    pair : T_SafeInputPair;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act
pair(
    In1 := TRUE,
    In2 := FALSE,
    Active1 := TRUE,
    Active2 := TRUE,
    Monitor := TRUE,
    SafeInputsAfterDiscError := TRUE
);

// assert
AssertEquals_BOOL(Expected := TRUE, Actual := pair.SafeStateRequested, Message := 'one low channel must request the safe state');
AssertEquals_BOOL(Expected := FALSE, Actual := pair.DiscrepancyError, Message := 'no discrepancy monitoring without a discrepancy time');
pair(
    In1 := TRUE,
    In2 := TRUE,
    Active1 := TRUE,
    Active2 := TRUE,
    Monitor := TRUE,
    SafeInputsAfterDiscError := TRUE
);

AssertEquals_BOOL(Expected := FALSE, Actual := pair.SafeStateRequested, Message := 'both channels high must not request the safe state');
TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>