<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeOpMode_Tests_CFC" Id="{d4ff5807-e0e1-5d5f-bbc6-50a8a8e56b77}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeOpMode_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeOpMode_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_ExactlyOneInputSelectsOutput
    group_1 : T_SafeGroup;
    fb_1 : T_SafeOpMode(group := group_1);
    // Test_ConnectedRestartRequiresRestartSequence
    group_2 : T_SafeGroup;
    fb_2 : T_SafeOpMode(group := group_2);
    // Test_SlowModeChangeGivesDiscrepancyError
    group_3 : T_SafeGroup;
    fb_3 : T_SafeOpMode(group := group_3) := (Parameters := (DiscrepancyTime := T#100MS));
    t0_3 : TON;
    t1_3 : TON;
    trig1_3 : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_ExactlyOneInputSelectsOutput();
Test_ConnectedRestartRequiresRestartSequence();
Test_SlowModeChangeGivesDiscrepancyError();
]]></ST>
    </Implementation>
