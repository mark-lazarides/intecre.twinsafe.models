<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeMon_Tests_FBD" Id="{2c423990-77c0-54b5-82e4-048f3c38e1eb}" SpecialFunc="None">
    <Declaration><![CDATA[// FBD twin of T_SafeMon_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeMon_Tests_FBD EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_AutomaticRestartWhenGuardClosed
    group_1 : T_SafeGroup;
    fb_1 : T_SafeMon(group := group_1);
    // Test_SecureInputBypassesGuard
    group_2 : T_SafeGroup;
    fb_2 : T_SafeMon(group := group_2);
    // Test_ManualFunctionTestRequiresGuardOpenedOnce
    group_3 : T_SafeGroup;
    fb_3 : T_SafeMon(group := group_3) := (Parameters := (ManualFunctionTest := TRUE));
    // Test_EdmFaultWithoutManualRestartStaysSafe
    group_4 : T_SafeGroup;
    fb_4 : T_SafeMon(group := group_4);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_AutomaticRestartWhenGuardClosed();
Test_SecureInputBypassesGuard();
Test_ManualFunctionTestRequiresGuardOpenedOnce();
Test_EdmFaultWithoutManualRestartStaysSafe();
]]></ST>
    </Implementation>
