<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeMuting_Tests_CFC" Id="{cca67b61-3b3d-5c59-a961-95841c723a9f}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeMuting_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeMuting_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_OssdBlockedWithoutMutingGivesSafe
    group_1 : T_SafeGroup;
    fb_1 : T_SafeMuting(group := group_1);
    // Test_SequentialMutingKeepsOutputOn
    group_2 : T_SafeGroup;
    fb_2 : T_SafeMuting(group := group_2) := (Parameters := (SequentialInputs := TRUE));
    // Test_SequenceViolationGivesError
    group_3 : T_SafeGroup;
    fb_3 : T_SafeMuting(group := group_3) := (Parameters := (SequentialInputs := TRUE));
    // Test_TwoSensorParallelSequence
    group_4 : T_SafeGroup;
    fb_4 : T_SafeMuting(group := group_4);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_OssdBlockedWithoutMutingGivesSafe();
Test_SequentialMutingKeepsOutputOn();
Test_SequenceViolationGivesError();
Test_TwoSensorParallelSequence();
]]></ST>
    </Implementation>
