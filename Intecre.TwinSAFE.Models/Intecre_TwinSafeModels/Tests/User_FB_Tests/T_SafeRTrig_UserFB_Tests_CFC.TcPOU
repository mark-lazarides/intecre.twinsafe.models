  <POU Name="T_SafeRTrig_UserFB_Tests_CFC" Id="{6bab9a86-ad8c-5de3-9a5a-59b7d0175202}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeRTrig_UserFB_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeRTrig_UserFB_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_TriggerForOneCycleOnRisingEdge
    group_1 : T_SafeGroup;
    fb_1 : T_SafeRTrig_UserFB(group := group_1);
    // Test_StoppedGivesNoOutput
    group_2 : T_SafeGroup;
    fb_2 : T_SafeRTrig_UserFB(group := group_2);
    // Test_InnerBlocksJoinTheGroup
    group_3 : T_SafeGroup;
    fb_3 : T_SafeRTrig_UserFB(group := group_3);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_TriggerForOneCycleOnRisingEdge();
Test_StoppedGivesNoOutput();
Test_InnerBlocksJoinTheGroup();
]]></ST>
    </Implementation>
