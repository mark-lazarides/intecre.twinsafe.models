<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafePulse_UserFB_Tests_CFC" Id="{2a8e6648-429f-5918-9f15-1d35399b8dee}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafePulse_UserFB_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafePulse_UserFB_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_PulseForDelayTimeWhileInputHeld
    group_1 : T_SafeGroup;
    fb_1 : T_SafePulse_UserFB(group := group_1) := (Parameters := (DelayTime := T#100MS));
    trigStart_1 : R_TRIG;
    t1_1 : TON;
    t2_1 : TON;
    trig1_1 : R_TRIG;
    trig2_1 : R_TRIG;
    // Test_PulseEndsWhenInputDrops
    group_2 : T_SafeGroup;
    fb_2 : T_SafePulse_UserFB(group := group_2) := (Parameters := (DelayTime := T#100MS));
    // Test_StoppedGivesNoOutput
    group_3 : T_SafeGroup;
    fb_3 : T_SafePulse_UserFB(group := group_3) := (Parameters := (DelayTime := T#100MS));
    // Test_InnerBlocksJoinTheGroup
    group_4 : T_SafeGroup;
    fb_4 : T_SafePulse_UserFB(group := group_4);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_PulseForDelayTimeWhileInputHeld();
Test_PulseEndsWhenInputDrops();
Test_StoppedGivesNoOutput();
Test_InnerBlocksJoinTheGroup();
]]></ST>
    </Implementation>
