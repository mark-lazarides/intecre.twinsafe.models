<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="PRG_TestRunner" Id="{a9172ccf-b9da-5d74-8bc7-a3c822c21068}" SpecialFunc="None">
    <Declaration><![CDATA[// Runs every TcUnit test suite in the library.
PROGRAM PRG_TestRunner
VAR
    safeAndTests                    : T_SafeAnd_Tests;
    safeInputPairTests              : T_SafeInputPair_Tests;
    safeOrTests                     : T_SafeOr_Tests;
    safeXorTests                    : T_SafeXor_Tests;
    safeDecoupleTests               : T_SafeDecouple_Tests;
    safeOpModeTests                 : T_SafeOpMode_Tests;
    safeRsTests                     : T_SafeRs_Tests;
    safeSrTests                     : T_SafeSr_Tests;
    safeTonTests                    : T_SafeTon_Tests;
    safeTofTests                    : T_SafeTof_Tests;
    safeEdmTests                    : T_SafeEdm_Tests;
    safeEStopTests                  : T_SafeEStop_Tests;
    safeMonTests                    : T_SafeMon_Tests;
    safeTwoHandTests                : T_SafeTwoHand_Tests;
    safeMutingTests                 : T_SafeMuting_Tests;
    safeConnectionTests             : T_SafeConnection_Tests;
    safeConnShutdownTests           : T_SafeConnShutdown_Tests;
    safeGroupTests                  : T_SafeGroup_Tests;
    safePulseUserFbTests            : T_SafePulse_UserFB_Tests;
    safeRTrigUserFbTests            : T_SafeRTrig_UserFB_Tests;

    // CFC twins of the suites above
    safeAndTestsCfc                 : T_SafeAnd_Tests_CFC;
    safeInputPairTestsCfc           : T_SafeInputPair_Tests_CFC;
    safeOrTestsCfc                  : T_SafeOr_Tests_CFC;
    safeXorTestsCfc                 : T_SafeXor_Tests_CFC;
    safeDecoupleTestsCfc            : T_SafeDecouple_Tests_CFC;
    safeOpModeTestsCfc              : T_SafeOpMode_Tests_CFC;
    safeRsTestsCfc                  : T_SafeRs_Tests_CFC;
    safeSrTestsCfc                  : T_SafeSr_Tests_CFC;
    safeTonTestsCfc                 : T_SafeTon_Tests_CFC;
    safeTofTestsCfc                 : T_SafeTof_Tests_CFC;
    safeEdmTestsCfc                 : T_SafeEdm_Tests_CFC;
    safeEStopTestsCfc               : T_SafeEStop_Tests_CFC;
    safeMonTestsCfc                 : T_SafeMon_Tests_CFC;
    safeTwoHandTestsCfc             : T_SafeTwoHand_Tests_CFC;
    safeMutingTestsCfc              : T_SafeMuting_Tests_CFC;
    safeConnectionTestsCfc          : T_SafeConnection_Tests_CFC;
    safeConnShutdownTestsCfc        : T_SafeConnShutdown_Tests_CFC;
    safeGroupTestsCfc               : T_SafeGroup_Tests_CFC;
    safePulseUserFbTestsCfc         : T_SafePulse_UserFB_Tests_CFC;
    safeRTrigUserFbTestsCfc         : T_SafeRTrig_UserFB_Tests_CFC;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TcUnit.RUN();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
