<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeGroup_Tests_CFC" Id="{08c12432-c2e5-53a9-a415-0b3b635b9544}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeGroup_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeGroup_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_StopWhenRunFalse
    group_1 : T_SafeGroup;
    fb_1 : T_SafeAnd(group := group_1);
    // Test_RunsFunctionBlocksWithoutConnections
    group_2 : T_SafeGroup;
    fb_2 : T_SafeAnd(group := group_2);
    // Test_FbErrorStopsGroupAndErrAckRecovers
    group_3 : T_SafeGroup;
    eStop_3 : T_SafeEStop(group := group_3);
    andFb_3 : T_SafeAnd(group := group_3);
    // Test_ConnectionStartupAndComError
    group_4 : T_SafeGroup;
    terminal_4 : T_SafeInputTerminal(group := group_4);
    t1a_4 : TON;
    t1b_4 : TON;
    t2b_4 : TON;
    trig1a_4 : R_TRIG;
    trig1b_4 : R_TRIG;
    trig2b_4 : R_TRIG;
    t3_4 : TON;
    trig3_4 : R_TRIG;
    t0_4 : TON;
    t1_4 : TON;
    t2_4 : TON;
    t4_4 : TON;
    trig0_4 : R_TRIG;
    trig1_4 : R_TRIG;
    trig2_4 : R_TRIG;
    trig4_4 : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_StopWhenRunFalse();
Test_RunsFunctionBlocksWithoutConnections();
Test_FbErrorStopsGroupAndErrAckRecovers();
Test_ConnectionStartupAndComError();
]]></ST>
    </Implementation>
