<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="T_SafeAnd_Tests_FBD" Id="{026db4ae-ba13-58d5-9ad0-7293851d8ccd}" SpecialFunc="None">
    <Declaration><![CDATA[// FBD twin of T_SafeAnd_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeAnd_Tests_FBD EXTENDS TcUnit.FB_TestSuite
VAR
    // Test_AllConnectedInputsTrueGivesRun
    group_1 : T_SafeGroup;
    fb_1 : T_SafeAnd(group := group_1);
    // Test_OneInputFalseGivesSafe
    group_2 : T_SafeGroup;
    fb_2 : T_SafeAnd(group := group_2);
    // Test_UnconnectedInputsIgnoredAndMakeContactNegated
    group_3 : T_SafeGroup;
    fb_3 : T_SafeAnd(group := group_3) := (Parameters := (In2MakeContact := TRUE));
    // Test_StoppedGivesNoOutput
    group_4 : T_SafeGroup;
    fb_4 : T_SafeAnd(group := group_4);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_AllConnectedInputsTrueGivesRun();
Test_OneInputFalseGivesSafe();
Test_UnconnectedInputsIgnoredAndMakeContactNegated();
Test_StoppedGivesNoOutput();
]]></ST>
    </Implementation>
