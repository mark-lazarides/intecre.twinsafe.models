<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeAnd_Tests_CFC" Id="{0f19d271-aa04-5ab9-846c-ea140fc85df3}" SpecialFunc="None">
    <Declaration><![CDATA[    // CFC twin of T_SafeAnd_Tests: the same tests drawn as CFC diagrams, the way a TwinSAFE project is authored.
    FUNCTION_BLOCK T_SafeAnd_Tests_CFC EXTENDS T_SafeCfcTestSuite
    VAR
    // Test_AllConnectedInputsTrueGivesRun
    group_1 : T_SafeGroup;
    fb_1 : T_SafeAnd(group := group_1);
    // Test_OneInputFalseGivesSafe
    group_2 : T_SafeGroup;
    fb_2 : T_SafeAnd(group := group_2);
    // Test_UnconnectedInputsIgnoredAndMakeContactNegated
    group_3 : T_SafeGroup;
    fb_3 : T_SafeAnd(group := group_3) := (Parameters := (In2MakeContact := TRUE));
    // Test_StoppedGivesNoOutput
    group_4 : T_SafeGroup;
    fb_4 : T_SafeAnd(group := group_4);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_AllConnectedInputsTrueGivesRun();
Test_OneInputFalseGivesSafe();
Test_UnconnectedInputsIgnoredAndMakeContactNegated();
Test_StoppedGivesNoOutput();
]]></ST>
    </Implementation>
