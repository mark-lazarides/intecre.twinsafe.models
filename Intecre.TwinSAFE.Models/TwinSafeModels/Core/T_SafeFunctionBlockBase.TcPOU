<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeFunctionBlockBase" Id="{3ee74026-4686-522f-866c-819b453488a4}" SpecialFunc="None">
    <Declaration><![CDATA[// Common behaviour of every modelled TwinSAFE function block.
// FbRun and ErrAck are the signals a TwinSAFE group feeds to its FBs; wire them from
// T_SafeGroup.InRun and the group ErrAck. Left unconnected, the FB runs stand-alone.
// Derived classes implement Process() and keep Error, State and Diag up to date.
FUNCTION_BLOCK ABSTRACT T_SafeFunctionBlockBase
VAR_INPUT
    FbRun  : BOOL := TRUE;   // group in RUN (T_SafeGroup.InRun)
    ErrAck : BOOL;           // group error acknowledge
END_VAR
VAR_OUTPUT
    Error     : BOOL;   // FB Error output
    State     : BYTE;   // FB state code (Map State)
    Diag      : WORD;   // FB diagnostic bits (Map Diag)
    IsRunning : BOOL;   // FB in the RUN state (feeds T_SafeGroup.AllFbsRunning)
END_VAR
VAR
    _errAckPrev        : BOOL;
    _errAckRisingEdge  : BOOL;
    _errAckFallingEdge : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_errAckRisingEdge := ErrAck AND NOT _errAckPrev;
_errAckFallingEdge := NOT ErrAck AND _errAckPrev;
_errAckPrev := ErrAck;
Process();
IsRunning := (State = 1);
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{9011d810-8dad-589f-942f-6deff444fa75}">
      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT Process
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetDiagBit" Id="{8e5efcfc-fc2b-5a77-a9d5-44f766f6363b}">
      <Declaration><![CDATA[METHOD PROTECTED SetDiagBit
VAR_INPUT
    bitIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Diag := Diag OR SHL(WORD#1, bitIndex);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearDiagBit" Id="{49190d3a-7696-50e6-bca4-a0c8c2d1b475}">
      <Declaration><![CDATA[METHOD PROTECTED ClearDiagBit
VAR_INPUT
    bitIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Diag := Diag AND NOT SHL(WORD#1, bitIndex);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
