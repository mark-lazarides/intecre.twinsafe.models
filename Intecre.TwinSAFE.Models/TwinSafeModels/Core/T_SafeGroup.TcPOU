<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeGroup" Id="{ca60e3b3-c5d3-5e53-9c71-9f6eafeaee90}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of a TwinSAFE group (EL/EJ6910 semantics).
// Wire InRun to the FbRun input of every FB in the group and the group ErrAck to their ErrAck input.
// Feed back the FBs and connections through AnyFbError, AllFbsRunning, AnyComError and AnyComStartup
// (OR / AND of the corresponding FB and connection outputs).
FUNCTION_BLOCK T_SafeGroup
VAR_INPUT
    Run           : BOOL := TRUE;   // Run/Stop. Link to a standard PLC variable.
    ErrAck        : BOOL;           // Error acknowledge (FALSE -> TRUE -> FALSE). Link to a standard PLC variable.
    ModuleFault   : BOOL;           // error input from another module (e.g. EK1960)
    AnyFbError    : BOOL;           // OR of the Error outputs of the group's FBs
    AllFbsRunning : BOOL := TRUE;   // AND of the IsRunning outputs of the group's FBs
    AnyComError   : BOOL;           // OR of the ComError outputs of the group's connections / terminals
    AnyComStartup : BOOL;           // OR of the InStartup outputs of the group's connections / terminals
END_VAR
VAR_OUTPUT
    ComErr     : BOOL;   // communication error in at least one connection
    FbErr      : BOOL;   // at least one FB is in the ERROR state
    OutErr     : BOOL;   // not used (local outputs only exist on KL6904)
    OtherErr   : BOOL;   // ModuleFault
    ComStartup : BOOL;   // at least one connection is starting up
    FbDeactive : BOOL;   // group deactivated by customising (not modelled, always FALSE)
    FbRun      : BOOL;   // all FBs are in the RUN state
    InRun      : BOOL;   // the group is in the RUN state -> FbRun of the FBs
    State      : BYTE;   // group state code (Map State)
    Diag       : BYTE;   // group diagnostic code (Map Diag)
END_VAR
VAR
    _state             : E_SafeGroupState := E_SafeGroupState.Stop;
    _prevState         : E_SafeGroupState;
    _errAckPrev        : BOOL;
    _errAckFallingEdge : BOOL;
    _anyError          : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_errAckFallingEdge := NOT ErrAck AND _errAckPrev;
_errAckPrev := ErrAck;
_anyError := AnyFbError OR AnyComError OR ModuleFault;

CASE _state OF
    E_SafeGroupState.Undefined,
    E_SafeGroupState.Stop:
        StateChanged();
        IF _anyError THEN
            _state := E_SafeGroupState.StopError;
        ELSIF Run THEN
            _state := SEL(AnyComStartup, E_SafeGroupState.Run, E_SafeGroupState.Start);
        END_IF

    E_SafeGroupState.StopError:
        StateChanged();
        IF Run THEN
            _state := E_SafeGroupState.Error;
        ELSIF NOT _anyError THEN
            _state := E_SafeGroupState.Stop;
        END_IF

    E_SafeGroupState.Start:
        StateChanged();
        IF _anyError THEN
            _state := E_SafeGroupState.Error;
        ELSIF NOT Run THEN
            _state := E_SafeGroupState.Stop;
        ELSIF NOT AnyComStartup THEN
            _state := E_SafeGroupState.Run;
        END_IF

    E_SafeGroupState.Run:
        StateChanged();
        IF _anyError THEN
            _state := E_SafeGroupState.Error;
        ELSIF NOT Run THEN
            _state := E_SafeGroupState.Stop;
        ELSIF AnyComStartup THEN
            _state := E_SafeGroupState.Start;
        END_IF

    E_SafeGroupState.Error:
        StateChanged();
        IF NOT Run THEN
            _state := E_SafeGroupState.StopError;
        ELSIF ErrAck AND NOT _anyError THEN
            _state := E_SafeGroupState.Reset;
        END_IF

    E_SafeGroupState.Reset:
        StateChanged();
        IF _anyError THEN
            _state := E_SafeGroupState.Error;
        ELSIF _errAckFallingEdge THEN
            IF NOT Run THEN
                _state := E_SafeGroupState.Stop;
            ELSIF AnyComStartup THEN
                _state := E_SafeGroupState.Start;
            ELSE
                _state := E_SafeGroupState.Run;
            END_IF
        END_IF

ELSE
    _state := E_SafeGroupState.Stop;
END_CASE

ComErr := AnyComError;
FbErr := AnyFbError;
OutErr := FALSE;
OtherErr := ModuleFault;
ComStartup := AnyComStartup;
FbDeactive := FALSE;
FbRun := AllFbsRunning;
InRun := (_state = E_SafeGroupState.Run);
State := TO_BYTE(_state);
IF AnyFbError THEN
    Diag := TO_BYTE(E_SafeGroupDiag.FbError);
ELSIF AnyComError THEN
    Diag := TO_BYTE(E_SafeGroupDiag.ComError);
ELSIF ModuleFault THEN
    Diag := TO_BYTE(E_SafeGroupDiag.ModuleError);
ELSE
    Diag := TO_BYTE(E_SafeGroupDiag.NoError);
END_IF
]]></ST>
    </Implementation>
    <Method Name="StateChanged" Id="{7729e32f-e128-5432-b1a8-540fa8176f1d}">
      <Declaration><![CDATA[METHOD PRIVATE StateChanged : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _prevState = _state THEN
    RETURN;
END_IF
_prevState := _state;
StateChanged := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="GroupState" Id="{88c560ad-a012-59c6-aebe-9cf6cecc461d}">
      <Declaration><![CDATA[PROPERTY GroupState : E_SafeGroupState
]]></Declaration>
      <Get Name="Get" Id="{47ddc3bb-ec02-5df3-b434-0c29bf085089}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[GroupState := _state;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
