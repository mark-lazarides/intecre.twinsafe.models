<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeXor_Tests" Id="{49565ad5-e6ff-5649-9293-99a76926fdec}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeXor_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_ConnectedPairsAreExclusiveOr();
]]></ST>
    </Implementation>
    <Method Name="Test_ConnectedPairsAreExclusiveOr" Id="{ac003e1f-c9f0-5abe-ba2c-416eccd82f63}">
      <Declaration><![CDATA[METHOD PRIVATE Test_ConnectedPairsAreExclusiveOr
VAR
        fb : T_SafeXor;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act
    fb(FbRun := TRUE, Xor1In1 := TRUE, Xor2In1 := FALSE);
    // assert
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.XorOut1, Message := 'connected pair 1 XOR');
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.XorOut2, Message := 'unconnected pair stays 0');
    fb(FbRun := TRUE, Xor1In1 := TRUE, Xor2In1 := TRUE);
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.XorOut1, Message := 'both inputs 1 gives 0');
    TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
