<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeSr_Tests" Id="{1d7ca810-c3c7-5427-960e-46985b1d864e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeSr_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_SetDominantLatch();
]]></ST>
    </Implementation>
    <Method Name="Test_SetDominantLatch" Id="{0101a96f-fe80-50b6-94a4-1d27727dfa03}">
      <Declaration><![CDATA[METHOD PRIVATE Test_SetDominantLatch
VAR
        fb : T_SafeSr;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// act / assert
    fb(FbRun := TRUE, Set := TRUE, Reset := TRUE);
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.SrOut, Message := 'set dominant');
    fb(FbRun := TRUE, Set := FALSE, Reset := TRUE);
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.SrOut, Message := 'reset');
    fb(FbRun := TRUE, Set := FALSE, Reset := FALSE);
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.SrOut, Message := 'held');
    TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
