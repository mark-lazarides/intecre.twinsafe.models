  <POU Name="T_SafeMuting_Tests_FBD" Id="{106d4a5a-fa7f-5330-885e-e463dff55189}" SpecialFunc="None">
    <Declaration><![CDATA[// FBD twin of T_SafeMuting_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeMuting_Tests_FBD EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_OssdBlockedWithoutMutingGivesSafe();
Test_SequentialMutingKeepsOutputOn();
Test_SequenceViolationGivesError();
Test_TwoSensorParallelSequence();
]]></ST>
    </Implementation>
