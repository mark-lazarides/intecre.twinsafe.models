<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeConnShutdown_Tests" Id="{890d9722-1a28-55d9-ba8b-cfb20b780363}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeConnShutdown_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_DeactivateShutsDownConnection();
]]></ST>
    </Implementation>
    <Method Name="Test_DeactivateShutsDownConnection" Id="{43cdc765-4ed8-5ff9-a86e-a1b4964d35b2}">
      <Declaration><![CDATA[METHOD PRIVATE Test_DeactivateShutsDownConnection
VAR
        fb   : T_SafeConnShutdown;
        conn : T_SafeConnection;
        i    : INT;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// arrange: connection up
    FOR i := 1 TO 5 DO
        conn(GroupRun := TRUE, LocalShutdown := fb.ShutdownRequest, StartupTime := T#0S);
        fb(FbRun := TRUE, Deactivate1 := FALSE, ConnectionShutdown := conn.IsShutdown);
    END_FOR
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.Deactivated, Message := 'connection up');
    // act
    fb(FbRun := TRUE, Deactivate1 := TRUE, ConnectionShutdown := conn.IsShutdown);
    conn(GroupRun := TRUE, LocalShutdown := fb.ShutdownRequest, StartupTime := T#0S);
    fb(FbRun := TRUE, Deactivate1 := TRUE, ConnectionShutdown := conn.IsShutdown);
    // assert
    AssertEquals_BOOL(Expected := TRUE, Actual := conn.IsShutdown, Message := 'connection shut down');
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.Deactivated, Message := 'Deactivated output on');
    // act: release
    FOR i := 1 TO 6 DO
        fb(FbRun := TRUE, Deactivate1 := FALSE, ConnectionShutdown := conn.IsShutdown);
        conn(GroupRun := TRUE, LocalShutdown := fb.ShutdownRequest, StartupTime := T#0S);
    END_FOR
    AssertEquals_BOOL(Expected := TRUE, Actual := conn.InDataState, Message := 'connection re-established');
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.Deactivated, Message := 'Deactivated output off');
    TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
