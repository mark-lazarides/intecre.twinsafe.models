<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeTon_Tests" Id="{0246d7a3-1b43-5c52-9a5a-d537dc1999e0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeTon_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_OutputDelayedOn();
]]></ST>
    </Implementation>
    <Method Name="Test_OutputDelayedOn" Id="{8c094113-831d-5f18-a4a7-ca612caea250}">
      <Declaration><![CDATA[METHOD PRIVATE Test_OutputDelayedOn
VAR_INST
        fb        : T_SafeTon := (Parameters := (DelayTime := T#100MS));
        state     : INT := 10;
        waitTimer : TON;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
waitTimer();
    CASE state OF
        10:
            // act
            fb(FbRun := TRUE, TonIn1 := TRUE);
            // assert
            AssertEquals_BOOL(Expected := FALSE, Actual := fb.TonOut, Message := 'output not yet on');
            AssertEquals_BYTE(Expected := TO_BYTE(E_SafeTonState.DelayIn), Actual := fb.State, Message := 'state DELAYIN');
            state := 20;
            waitTimer(IN := TRUE, PT := T#200MS);
        20:
            fb(FbRun := TRUE, TonIn1 := TRUE);
            IF NOT waitTimer.Q THEN
                RETURN;
            END_IF
            waitTimer(IN := FALSE);
            // assert
            AssertEquals_BOOL(Expected := TRUE, Actual := fb.TonOut, Message := 'output on after the delay');
            fb(FbRun := TRUE, TonIn1 := FALSE);
            AssertEquals_BOOL(Expected := FALSE, Actual := fb.TonOut, Message := 'output off immediately');
            TEST_FINISHED_NAMED(__POUNAME());
            state := 10;
    END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
