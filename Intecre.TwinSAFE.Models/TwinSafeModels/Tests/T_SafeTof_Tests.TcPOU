<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeTof_Tests" Id="{978229da-758b-5bed-80ea-cf07aeecdce2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeTof_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_OutputDelayedOff();
]]></ST>
    </Implementation>
    <Method Name="Test_OutputDelayedOff" Id="{b6d59bd9-12c1-5814-8994-2d4710fe2757}">
      <Declaration><![CDATA[METHOD PRIVATE Test_OutputDelayedOff
VAR_INST
        fb        : T_SafeTof := (Parameters := (DelayTime := T#100MS));
        state     : INT := 10;
        waitTimer : TON;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
waitTimer();
    CASE state OF
        10:
            fb(FbRun := TRUE, TofIn1 := TRUE);
            AssertEquals_BOOL(Expected := TRUE, Actual := fb.TofOut, Message := 'output on immediately');
            // act
            fb(FbRun := TRUE, TofIn1 := FALSE);
            AssertEquals_BOOL(Expected := TRUE, Actual := fb.TofOut, Message := 'output held during the delay');
            AssertEquals_BYTE(Expected := TO_BYTE(E_SafeFbState.DelayOut), Actual := fb.State, Message := 'state DELAYOUT');
            state := 20;
            waitTimer(IN := TRUE, PT := T#200MS);
        20:
            fb(FbRun := TRUE, TofIn1 := FALSE);
            IF NOT waitTimer.Q THEN
                RETURN;
            END_IF
            waitTimer(IN := FALSE);
            // assert
            AssertEquals_BOOL(Expected := FALSE, Actual := fb.TofOut, Message := 'output off after the delay');
            TEST_FINISHED_NAMED(__POUNAME());
            state := 10;
    END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
