  <POU Name="T_SafeEStop_Tests_FBD" Id="{b100ba95-b645-5553-a9ce-21d93ad9be5a}" SpecialFunc="None">
    <Declaration><![CDATA[// FBD twin of T_SafeEStop_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeEStop_Tests_FBD EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_OutputsOffWhenStopped();
Test_StartupRequiresRestartSequence();
Test_EStopRequestSwitchesOutputsOffAndBlocksRestart();
Test_MakeContactInputRequestsSafeStateOnOne();
Test_EdmErrorAtRestartAndAcknowledge();
Test_RestartHeldBeforeEStopGivesEdmError();
Test_DelayedOutput();
Test_DiscrepancyErrorNeedsSafeInputsBeforeAck();
]]></ST>
    </Implementation>
