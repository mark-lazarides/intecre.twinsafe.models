<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeMuting_Tests" Id="{c85282b9-caf1-55d6-8c17-d732599574b8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeMuting_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_OssdBlockedWithoutMutingGivesSafe();
Test_SequentialMutingKeepsOutputOn();
Test_SequenceViolationGivesError();
Test_TwoSensorParallelSequence();
]]></ST>
    </Implementation>
    <Method Name="Test_OssdBlockedWithoutMutingGivesSafe" Id="{53af24ac-e7d4-5870-b8e6-91c27b55d90e}">
      <Declaration><![CDATA[METHOD PRIVATE Test_OssdBlockedWithoutMutingGivesSafe
VAR
        fb : T_SafeMuting;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// arrange: only the protective device connected
    fb(FbRun := TRUE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, OSSDIn1 := TRUE);
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.MuteOut, Message := 'output on with clear protective device');
    // act
    fb(FbRun := TRUE, OSSDIn1 := FALSE);
    // assert
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.MuteOut, Message := 'output off when interrupted');
    AssertEquals_BYTE(Expected := TO_BYTE(E_SafeMutingState.Safe), Actual := fb.State, Message := 'state SAFE');
    fb(FbRun := TRUE, OSSDIn1 := TRUE);
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.MuteOut, Message := 'automatic restart when clear again');
    TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_SequentialMutingKeepsOutputOn" Id="{c6a7cee4-9819-51b8-ac3e-fe5e81a597be}">
      <Declaration><![CDATA[METHOD PRIVATE Test_SequentialMutingKeepsOutputOn
VAR
        fb : T_SafeMuting := (Parameters := (SequentialInputs := TRUE));
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// arrange: four single-channel sensors, running
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    // act: M1, M2, OSSD blocked, M3, M1 off, M4, M2 off, OSSD clear, M3 off, M4 off
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    AssertEquals_BYTE(Expected := TO_BYTE(E_SafeMutingState.Muting1), Actual := fb.State, Message := 'MUTING1');
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.MutingActive, Message := 'muting active');
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := TRUE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := TRUE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := FALSE);
    AssertEquals_BYTE(Expected := TO_BYTE(E_SafeMutingState.Muting3), Actual := fb.State, Message := 'MUTING3');
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.MuteOut, Message := 'output stays on while muted');
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := TRUE, MutingIn3 := TRUE, MutingIn4 := FALSE, OSSDIn1 := FALSE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := TRUE, MutingIn3 := TRUE, MutingIn4 := FALSE, OSSDIn1 := FALSE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := TRUE, MutingIn3 := TRUE, MutingIn4 := TRUE, OSSDIn1 := FALSE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := TRUE, MutingIn4 := TRUE, OSSDIn1 := FALSE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := TRUE, MutingIn4 := TRUE, OSSDIn1 := TRUE);
    AssertEquals_BYTE(Expected := TO_BYTE(E_SafeMutingState.Muting8), Actual := fb.State, Message := 'MUTING8');
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := TRUE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    // assert
    AssertEquals_BYTE(Expected := TO_BYTE(E_SafeMutingState.Run), Actual := fb.State, Message := 'RUN after the sequence');
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.MutingActive, Message := 'muting no longer active');
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.Error, Message := 'no error');
    TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_SequenceViolationGivesError" Id="{d6e4901c-3232-5651-8e58-db1174e3a5fe}">
      <Declaration><![CDATA[METHOD PRIVATE Test_SequenceViolationGivesError
VAR
        fb : T_SafeMuting := (Parameters := (SequentialInputs := TRUE));
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// arrange
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    // act: OSSD blocked before the second sensor
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := FALSE);
    // assert
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.Error, Message := 'sequence violation');
    AssertEquals_WORD(Expected := WORD#64, Actual := fb.Diag, Message := 'diag bit 6');
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.MuteOut, Message := 'output off');
    TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_TwoSensorParallelSequence" Id="{9b5f1feb-99b7-5bbd-986f-8a560ec1e607}">
      <Declaration><![CDATA[METHOD PRIVATE Test_TwoSensorParallelSequence
VAR
        fb : T_SafeMuting;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
// arrange: two two-channel sensors (parallel inputs), running
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    // act: S1, S2, OSSD blocked, S1 off, OSSD clear, S2 off
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := TRUE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := TRUE, MutingIn3 := TRUE, MutingIn4 := TRUE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := TRUE, MutingIn2 := TRUE, MutingIn3 := TRUE, MutingIn4 := TRUE, OSSDIn1 := FALSE);
    AssertEquals_BOOL(Expected := TRUE, Actual := fb.MuteOut, Message := 'output stays on while muted');
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := TRUE, MutingIn4 := TRUE, OSSDIn1 := FALSE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := TRUE, MutingIn4 := TRUE, OSSDIn1 := TRUE);
    fb(FbRun := TRUE, MutingEnable := TRUE, MutingIn1 := FALSE, MutingIn2 := FALSE, MutingIn3 := FALSE, MutingIn4 := FALSE, OSSDIn1 := TRUE);
    // assert
    AssertEquals_BYTE(Expected := TO_BYTE(E_SafeMutingState.Run), Actual := fb.State, Message := 'RUN after the sequence');
    AssertEquals_BOOL(Expected := FALSE, Actual := fb.Error, Message := 'no error');
    TEST_FINISHED_NAMED(__POUNAME());
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
