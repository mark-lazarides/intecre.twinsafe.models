<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeEdm_Tests" Id="{9cd20ad8-7fd0-5834-8452-47fa258aa93f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_SafeEdm_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_SwitchOnTimeoutGivesError();
Test_NoErrorWhenFeedbackFollows();
]]></ST>
    </Implementation>
    <Method Name="Test_SwitchOnTimeoutGivesError" Id="{27af466d-3ba9-5861-87db-c799da121c85}">
      <Declaration><![CDATA[METHOD PRIVATE Test_SwitchOnTimeoutGivesError
VAR_INST
        fb        : T_SafeEdm := (Parameters := (SwitchOnTime := T#100MS));
        state     : INT := 10;
        waitTimer : TON;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
waitTimer();
    CASE state OF
        10:
            state := 20;
            waitTimer(IN := TRUE, PT := T#250MS);
        20:
            // act: Mon1 on, feedback never follows
            fb(FbRun := TRUE, ErrAck := FALSE, Mon1 := TRUE, Mon2 := TRUE);
            IF NOT waitTimer.Q THEN
                RETURN;
            END_IF
            waitTimer(IN := FALSE);
            // assert
            AssertEquals_BOOL(Expected := TRUE, Actual := fb.Error, Message := 'error when Mon2 does not drop in time');
            AssertEquals_WORD(Expected := WORD#2, Actual := fb.Diag, Message := 'diag bit 1 switch-on timer elapsed');
            // act: acknowledge
            fb(FbRun := TRUE, ErrAck := TRUE, Mon1 := TRUE, Mon2 := TRUE);
            fb(FbRun := TRUE, ErrAck := FALSE, Mon1 := TRUE, Mon2 := FALSE);
            AssertEquals_BOOL(Expected := FALSE, Actual := fb.Error, Message := 'error cleared after acknowledgement');
            TEST_FINISHED_NAMED(__POUNAME());
            state := 10;
    END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_NoErrorWhenFeedbackFollows" Id="{f2724108-6ac0-5bcf-aebf-75a90bedea1a}">
      <Declaration><![CDATA[METHOD PRIVATE Test_NoErrorWhenFeedbackFollows
VAR_INST
        fb        : T_SafeEdm := (Parameters := (SwitchOnTime := T#100MS, SwitchOffTime := T#100MS));
        state     : INT := 10;
        waitTimer : TON;
    END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST(__POUNAME());
waitTimer();
    CASE state OF
        10:
            state := 20;
            waitTimer(IN := TRUE, PT := T#200MS);
        20:
            fb(FbRun := TRUE, Mon1 := TRUE, Mon2 := FALSE);
            IF NOT waitTimer.Q THEN
                RETURN;
            END_IF
            waitTimer(IN := FALSE);
            AssertEquals_BOOL(Expected := FALSE, Actual := fb.Error, Message := 'no error while feedback is correct');
            state := 30;
            waitTimer(IN := TRUE, PT := T#200MS);
        30:
            // act: switch off, feedback follows immediately
            fb(FbRun := TRUE, Mon1 := FALSE, Mon2 := TRUE);
            IF NOT waitTimer.Q THEN
                RETURN;
            END_IF
            waitTimer(IN := FALSE);
            AssertEquals_BOOL(Expected := FALSE, Actual := fb.Error, Message := 'no error after switch-off with feedback');
            TEST_FINISHED_NAMED(__POUNAME());
            state := 10;
    END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
