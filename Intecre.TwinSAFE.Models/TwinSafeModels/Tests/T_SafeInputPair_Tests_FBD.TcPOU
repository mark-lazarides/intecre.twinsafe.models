  <POU Name="T_SafeInputPair_Tests_FBD" Id="{a80a3b6f-c527-5b79-aade-12b50d21e0e2}" SpecialFunc="None">
    <Declaration><![CDATA[// FBD twin of T_SafeInputPair_Tests: the same tests authored as function block diagrams.
FUNCTION_BLOCK T_SafeInputPair_Tests_FBD EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_InactivePairNeverRequestsSafeState();
Test_BreakContactRequestsSafeStateOnZero();
Test_MakeContactRequestsSafeStateOnOne();
Test_TwoChannelRequestsSafeStateIfEitherChannelLow();
Test_DiscrepancyErrorAfterTimeoutAndResetAfterSafeInputs();
]]></ST>
    </Implementation>
