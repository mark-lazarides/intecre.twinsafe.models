<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeTwoHand" Id="{642f5929-5b8e-556b-bbbc-2f5ce0aa8169}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB TWOHAND (two-hand control).
// Both hands (input pairs) must be actuated, optionally within HandDiscrepancyTime of each other.
// The output can only be set again after both hands were released together.
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeTwoHand EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    Twohand1   : BOOL;   // first hand, channel 1
    Twohand2   : BOOL;   // first hand, channel 2
    Twohand3   : BOOL;   // second hand, channel 1
    Twohand4   : BOOL;   // second hand, channel 2
    Parameters : ST_SafeTwoHandParameters;
END_VAR
VAR_OUTPUT
    TwoHandOut : BOOL;
END_VAR
VAR
    {attribute 'is_connected' := 'Twohand1'}
    _twohand1Connected     : BOOL;
    {attribute 'is_connected' := 'Twohand2'}
    _twohand2Connected     : BOOL;
    {attribute 'is_connected' := 'Twohand3'}
    _twohand3Connected     : BOOL;
    {attribute 'is_connected' := 'Twohand4'}
    _twohand4Connected     : BOOL;
    _pairs           : ARRAY[1..2] OF T_SafeInputPair;
    _state           : E_SafeTwoHandState := E_SafeTwoHandState.Stop;
    _prevState       : E_SafeTwoHandState;
    _handTimer       : TON;
    _awaitingRelease : BOOL;   // between-hands discrepancy error waits for both hands released
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{2d934233-a7d7-59b1-97df-19805068c735}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    acknowledge : BOOL;
    hand1       : BOOL;   // first hand fully actuated
    hand2       : BOOL;   // second hand fully actuated
    anyFalse    : BOOL;   // at least one active input released
    allFalse    : BOOL;   // every active input released
    discError   : BOOL;
    operating   : BOOL;
    stateBefore    : E_SafeTwoHandState;
    passes         : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[acknowledge := (_state = E_SafeTwoHandState.Error) AND ErrAck AND NOT _awaitingRelease;
_pairs[1](
    In1 := Twohand1, In2 := Twohand2,
    Active1 := _twohand1Connected, Active2 := _twohand2Connected,
    MakeContact1 := Parameters.Twohand1MakeContact, MakeContact2 := Parameters.Twohand2MakeContact,
    DiscrepancyTime := Parameters.DiscrepancyTime1,
    Monitor := FbRun,
    SafeInputsAfterDiscError := Parameters.SafeInputsAfterDiscError,
    Acknowledge := acknowledge);
_pairs[2](
    In1 := Twohand3, In2 := Twohand4,
    Active1 := _twohand3Connected, Active2 := _twohand4Connected,
    MakeContact1 := Parameters.Twohand3MakeContact, MakeContact2 := Parameters.Twohand4MakeContact,
    DiscrepancyTime := Parameters.DiscrepancyTime2,
    Monitor := FbRun,
    SafeInputsAfterDiscError := Parameters.SafeInputsAfterDiscError,
    Acknowledge := acknowledge);
hand1 := _pairs[1].IsActive AND _pairs[1].AllTrue;
hand2 := _pairs[2].IsActive AND _pairs[2].AllTrue;
anyFalse := NOT (_pairs[1].AllTrue AND _pairs[2].AllTrue);
allFalse := (NOT _pairs[1].IsActive OR _pairs[1].AllFalse) AND (NOT _pairs[2].IsActive OR _pairs[2].AllFalse);
discError := _pairs[1].DiscrepancyError OR _pairs[2].DiscrepancyError;

IF NOT FbRun AND _state <> E_SafeTwoHandState.Error AND _state <> E_SafeTwoHandState.Reset THEN
    _state := E_SafeTwoHandState.Stop;
END_IF

operating := (_state = E_SafeTwoHandState.Safe) OR (_state = E_SafeTwoHandState.OneButton)
          OR (_state = E_SafeTwoHandState.TwoButton) OR (_state = E_SafeTwoHandState.Run)
          OR (_state = E_SafeTwoHandState.Release);
IF discError AND operating THEN
    UpdateDiscrepancyDiag();
    _state := E_SafeTwoHandState.Error;
END_IF

IF _awaitingRelease AND allFalse THEN
    _awaitingRelease := FALSE;
END_IF

passes := 0;
REPEAT
    stateBefore := _state;
    CASE _state OF
        E_SafeTwoHandState.Stop:
            IF StateChanged() THEN
                TwoHandOut := FALSE;
                Error := FALSE;
                Diag := 0;
            END_IF
            IF FbRun THEN
                _state := E_SafeTwoHandState.Safe;
            END_IF

        E_SafeTwoHandState.Safe:
            IF StateChanged() THEN
                TwoHandOut := FALSE;
            END_IF
            IF hand1 THEN
                _state := E_SafeTwoHandState.OneButton;
            ELSIF hand2 THEN
                _state := E_SafeTwoHandState.TwoButton;
            END_IF

        E_SafeTwoHandState.OneButton:
            IF StateChanged() THEN
                _handTimer(IN := FALSE, PT := Parameters.HandDiscrepancyTime);
            END_IF
            _handTimer(IN := (Parameters.HandDiscrepancyTime > T#0S), PT := Parameters.HandDiscrepancyTime);
            IF _handTimer.Q THEN
                SetHandDiscrepancyError();
            ELSIF hand1 AND hand2 THEN
                _state := E_SafeTwoHandState.Run;
            ELSIF hand2 THEN
                // second hand actuated while the first is no longer detected
                SetDiagBit(6);
                _state := E_SafeTwoHandState.Error;
            ELSIF NOT hand1 THEN
                _state := SEL(allFalse, E_SafeTwoHandState.Release, E_SafeTwoHandState.Safe);
            END_IF

        E_SafeTwoHandState.TwoButton:
            IF StateChanged() THEN
                _handTimer(IN := FALSE, PT := Parameters.HandDiscrepancyTime);
            END_IF
            _handTimer(IN := (Parameters.HandDiscrepancyTime > T#0S), PT := Parameters.HandDiscrepancyTime);
            IF _handTimer.Q THEN
                SetHandDiscrepancyError();
            ELSIF hand1 AND hand2 THEN
                _state := E_SafeTwoHandState.Run;
            ELSIF hand1 THEN
                SetDiagBit(6);
                _state := E_SafeTwoHandState.Error;
            ELSIF NOT hand2 THEN
                _state := SEL(allFalse, E_SafeTwoHandState.Release, E_SafeTwoHandState.Safe);
            END_IF

        E_SafeTwoHandState.Run:
            IF StateChanged() THEN
                TwoHandOut := TRUE;
            END_IF
            IF anyFalse THEN
                _state := E_SafeTwoHandState.Release;
            END_IF

        E_SafeTwoHandState.Release:
            IF StateChanged() THEN
                TwoHandOut := FALSE;
            END_IF
            IF allFalse THEN
                _state := E_SafeTwoHandState.Safe;
            END_IF

        E_SafeTwoHandState.Error:
            IF StateChanged() THEN
                TwoHandOut := FALSE;
                Error := TRUE;
            END_IF
            UpdateDiscrepancyDiag();
            IF _awaitingRelease THEN
                SetDiagBit(10);
            ELSE
                ClearDiagBit(10);
            END_IF
            IF ErrAck AND NOT _awaitingRelease AND NOT discError THEN
                _state := E_SafeTwoHandState.Reset;
            END_IF

        E_SafeTwoHandState.Reset:
            IF StateChanged() THEN
                TwoHandOut := FALSE;
                Error := FALSE;
                Diag := 0;
            END_IF
            IF _errAckFallingEdge THEN
                _state := SEL(FbRun, E_SafeTwoHandState.Stop, E_SafeTwoHandState.Safe);
            END_IF
    END_CASE
    passes := passes + 1;
UNTIL (stateBefore = _state) OR (passes >= 3)
END_REPEAT

State := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetHandDiscrepancyError" Id="{cd3b13a6-de6e-5d53-8aee-003febfb10b3}">
      <Declaration><![CDATA[METHOD PRIVATE SetHandDiscrepancyError
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetDiagBit(2);
_awaitingRelease := Parameters.SafeInputsAfterDiscError;
_state := E_SafeTwoHandState.Error;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateChanged" Id="{835da954-1f5c-50a6-b2d3-8f8b15024dce}">
      <Declaration><![CDATA[METHOD PRIVATE StateChanged : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _prevState = _state THEN
    RETURN;
END_IF
_prevState := _state;
StateChanged := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateDiscrepancyDiag" Id="{99391ed1-fe16-59f7-9b84-655eada67f47}">
      <Declaration><![CDATA[// Mirrors the discrepancy state of every pair into the diagnostic bits.
METHOD PRIVATE UpdateDiscrepancyDiag
VAR
    i : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 2 DO
    IF _pairs[i].DiscrepancyError THEN
        SetDiagBit(i - 1);
        IF _pairs[i].AwaitingSafeInputs THEN
            SetDiagBit(i + 7);
        ELSE
            ClearDiagBit(i + 7);
        END_IF
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Property Name="TwoHandState" Id="{c5becd3c-5b65-5369-bb49-7ff1d38a290a}">
      <Declaration><![CDATA[PROPERTY TwoHandState : E_SafeTwoHandState
]]></Declaration>
      <Get Name="Get" Id="{a3b73e15-c004-56c1-856e-35840cbf43dd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TwoHandState := _state;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
