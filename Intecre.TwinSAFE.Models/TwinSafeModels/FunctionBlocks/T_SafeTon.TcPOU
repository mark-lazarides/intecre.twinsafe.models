<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeTon" Id="{1b95320b-0d3a-5923-8ff0-0651093a6525}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB TON (switch-on delay).
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeTon EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    TonIn1     : BOOL;
    Parameters : ST_SafeTimerParameters;
END_VAR
VAR_OUTPUT
    TonOut : BOOL;
END_VAR
VAR
    {attribute 'is_connected' := 'TonIn1'}
    _tonIn1Connected       : BOOL;
    _state : E_SafeTonState := E_SafeTonState.Stop;
    _timer : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{e4417956-7233-5c5f-80ff-76deef0eb2c0}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    inputActive : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[inputActive := FbRun AND F_SafeInputValue(_tonIn1Connected, Parameters.MakeContact, TonIn1);
_timer(IN := inputActive, PT := Parameters.DelayTime);

IF NOT FbRun THEN
    _state := E_SafeTonState.Stop;
ELSIF NOT inputActive THEN
    _state := E_SafeTonState.Safe;
ELSIF _timer.Q THEN
    _state := E_SafeTonState.Run;
ELSE
    _state := E_SafeTonState.DelayIn;
END_IF

TonOut := (_state = E_SafeTonState.Run);
Error := FALSE;
Diag := 0;
State := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
