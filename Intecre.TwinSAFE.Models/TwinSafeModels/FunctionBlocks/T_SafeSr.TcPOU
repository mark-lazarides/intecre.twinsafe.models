<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeSr" Id="{f012fcb5-00f3-58d8-85cf-893035478446}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB SR (set dominant latch).
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeSr EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    Set        : BOOL;
    Reset      : BOOL;
    Parameters : ST_SafeLatchParameters;
END_VAR
VAR_OUTPUT
    SrOut : BOOL;
END_VAR
VAR
    {attribute 'is_connected' := 'Set'}
    _setConnected          : BOOL;
    {attribute 'is_connected' := 'Reset'}
    _resetConnected        : BOOL;
    _state : E_SafeLatchState := E_SafeLatchState.Stop;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{7e42194a-8cb8-5273-8753-b28131026d06}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    setActive   : BOOL;
    resetActive : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setActive := F_SafeInputValue(_setConnected, Parameters.SetMakeContact, Set);
resetActive := F_SafeInputValue(_resetConnected, Parameters.ResetMakeContact, Reset);

IF NOT FbRun THEN
    _state := E_SafeLatchState.Stop;
ELSE
    IF _state = E_SafeLatchState.Stop THEN
        _state := E_SafeLatchState.Safe;
    END_IF
    IF setActive THEN
        _state := E_SafeLatchState.Set;
    ELSIF resetActive THEN
        _state := E_SafeLatchState.Safe;
    END_IF
END_IF

SrOut := (_state = E_SafeLatchState.Set);
Error := FALSE;
Diag := 0;
State := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
