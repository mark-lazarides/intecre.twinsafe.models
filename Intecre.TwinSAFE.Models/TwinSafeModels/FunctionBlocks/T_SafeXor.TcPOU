<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeXor" Id="{d33ca10f-2fc9-5a8b-9b46-142db88d0673}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB XOR: eight independent exclusive-or pairs. A pair is active when connected.
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeXor EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    Xor1In1 : BOOL; Xor2In1 : BOOL;
    Xor1In2 : BOOL; Xor2In2 : BOOL;
    Xor1In3 : BOOL; Xor2In3 : BOOL;
    Xor1In4 : BOOL; Xor2In4 : BOOL;
    Xor1In5 : BOOL; Xor2In5 : BOOL;
    Xor1In6 : BOOL; Xor2In6 : BOOL;
    Xor1In7 : BOOL; Xor2In7 : BOOL;
    Xor1In8 : BOOL; Xor2In8 : BOOL;
END_VAR
VAR_OUTPUT
    XorOut1 : BOOL;
    XorOut2 : BOOL;
    XorOut3 : BOOL;
    XorOut4 : BOOL;
    XorOut5 : BOOL;
    XorOut6 : BOOL;
    XorOut7 : BOOL;
    XorOut8 : BOOL;
END_VAR
VAR
    {attribute 'is_connected' := 'Xor1In1'}
    _xor1In1Connected      : BOOL;
    {attribute 'is_connected' := 'Xor1In2'}
    _xor1In2Connected      : BOOL;
    {attribute 'is_connected' := 'Xor1In3'}
    _xor1In3Connected      : BOOL;
    {attribute 'is_connected' := 'Xor1In4'}
    _xor1In4Connected      : BOOL;
    {attribute 'is_connected' := 'Xor1In5'}
    _xor1In5Connected      : BOOL;
    {attribute 'is_connected' := 'Xor1In6'}
    _xor1In6Connected      : BOOL;
    {attribute 'is_connected' := 'Xor1In7'}
    _xor1In7Connected      : BOOL;
    {attribute 'is_connected' := 'Xor1In8'}
    _xor1In8Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In1'}
    _xor2In1Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In2'}
    _xor2In2Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In3'}
    _xor2In3Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In4'}
    _xor2In4Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In5'}
    _xor2In5Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In6'}
    _xor2In6Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In7'}
    _xor2In7Connected      : BOOL;
    {attribute 'is_connected' := 'Xor2In8'}
    _xor2In8Connected      : BOOL;
    _state : E_SafeFbState := E_SafeFbState.Stop;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{ec4b5fc2-4d53-5eec-a0d7-c9e74f1f3800}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    run : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[run := FbRun;
_state := SEL(run, E_SafeFbState.Stop, E_SafeFbState.Run);
XorOut1 := run AND (_xor1In1Connected OR _xor2In1Connected) AND (Xor1In1 XOR Xor2In1);
XorOut2 := run AND (_xor1In2Connected OR _xor2In2Connected) AND (Xor1In2 XOR Xor2In2);
XorOut3 := run AND (_xor1In3Connected OR _xor2In3Connected) AND (Xor1In3 XOR Xor2In3);
XorOut4 := run AND (_xor1In4Connected OR _xor2In4Connected) AND (Xor1In4 XOR Xor2In4);
XorOut5 := run AND (_xor1In5Connected OR _xor2In5Connected) AND (Xor1In5 XOR Xor2In5);
XorOut6 := run AND (_xor1In6Connected OR _xor2In6Connected) AND (Xor1In6 XOR Xor2In6);
XorOut7 := run AND (_xor1In7Connected OR _xor2In7Connected) AND (Xor1In7 XOR Xor2In7);
XorOut8 := run AND (_xor1In8Connected OR _xor2In8Connected) AND (Xor1In8 XOR Xor2In8);
Error := FALSE;
Diag := 0;
State := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
