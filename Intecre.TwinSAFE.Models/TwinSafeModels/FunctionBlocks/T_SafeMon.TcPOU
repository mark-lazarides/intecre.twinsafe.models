<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeMon" Id="{3443aedf-7876-561a-9f36-1eaa4e8a8901}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB MON (safety door / guard monitoring).
// Two MonIn pairs, a Secure pair that bypasses them, manual restart (when Restart is connected),
// manual function test, two EDM feedback loops and a delayed output.
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeMon EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    Restart    : BOOL;   // connect for manual restart; may be a standard PLC signal
    EDM1       : BOOL;   // feedback loop of MonOut
    EDM2       : BOOL;   // feedback loop of MonDelOut
    MonIn1     : BOOL;
    MonIn2     : BOOL;
    MonIn3     : BOOL;
    MonIn4     : BOOL;
    Secure1    : BOOL;   // when TRUE (after normalisation) the MonIn inputs are ignored
    Secure2    : BOOL;
    Parameters : ST_SafeMonParameters;
END_VAR
VAR_OUTPUT
    MonOut    : BOOL;
    MonDelOut : BOOL;
END_VAR
VAR
    {attribute 'is_connected' := 'Restart'}
    _restartConnected      : BOOL;
    {attribute 'is_connected' := 'EDM1'}
    _eDM1Connected         : BOOL;
    {attribute 'is_connected' := 'EDM2'}
    _eDM2Connected         : BOOL;
    {attribute 'is_connected' := 'MonIn1'}
    _monIn1Connected       : BOOL;
    {attribute 'is_connected' := 'MonIn2'}
    _monIn2Connected       : BOOL;
    {attribute 'is_connected' := 'MonIn3'}
    _monIn3Connected       : BOOL;
    {attribute 'is_connected' := 'MonIn4'}
    _monIn4Connected       : BOOL;
    {attribute 'is_connected' := 'Secure1'}
    _secure1Connected      : BOOL;
    {attribute 'is_connected' := 'Secure2'}
    _secure2Connected      : BOOL;
    _pairs             : ARRAY[1..3] OF T_SafeInputPair;   // 1: MonIn1/2, 2: MonIn3/4, 3: Secure1/2
    _state             : E_SafeMonState := E_SafeMonState.Stop;
    _prevState         : E_SafeMonState;
    _restartPrev       : BOOL;
    _delayTimer        : TON;
    _delayRunning      : BOOL;
    _funcTested        : ARRAY[1..2] OF BOOL;
    _edmResetTimer1    : TON;
    _edmResetTimer2    : TON;
    _edm1Dropped       : BOOL;
    _edm2Dropped       : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{2ce9690b-7b7d-5359-86f3-65ca505020f6}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    i              : USINT;
    acknowledge    : BOOL;
    monRequested   : BOOL;
    bypass         : BOOL;
    safeRequested  : BOOL;
    discError      : BOOL;
    restartFalling : BOOL;
    functionTestDue: BOOL;
    stateBefore    : E_SafeMonState;
    passes         : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[acknowledge := (_state = E_SafeMonState.Error) AND ErrAck;
_pairs[1](
    In1 := MonIn1, In2 := MonIn2,
    Active1 := _monIn1Connected, Active2 := _monIn2Connected,
    MakeContact1 := Parameters.MonIn1MakeContact, MakeContact2 := Parameters.MonIn2MakeContact,
    DiscrepancyTime := Parameters.DiscrepancyTime1,
    Monitor := FbRun,
    SafeInputsAfterDiscError := Parameters.SafeInputsAfterDiscError,
    Acknowledge := acknowledge);
_pairs[2](
    In1 := MonIn3, In2 := MonIn4,
    Active1 := _monIn3Connected, Active2 := _monIn4Connected,
    MakeContact1 := Parameters.MonIn3MakeContact, MakeContact2 := Parameters.MonIn4MakeContact,
    DiscrepancyTime := Parameters.DiscrepancyTime2,
    Monitor := FbRun,
    SafeInputsAfterDiscError := Parameters.SafeInputsAfterDiscError,
    Acknowledge := acknowledge);
_pairs[3](
    In1 := Secure1, In2 := Secure2,
    Active1 := _secure1Connected, Active2 := _secure2Connected,
    MakeContact1 := Parameters.Secure1MakeContact, MakeContact2 := Parameters.Secure2MakeContact,
    DiscrepancyTime := Parameters.SecureDiscrepancyTime,
    Monitor := FbRun,
    SafeInputsAfterDiscError := Parameters.SafeInputsAfterDiscError,
    Acknowledge := acknowledge);
monRequested := _pairs[1].SafeStateRequested OR _pairs[2].SafeStateRequested;
bypass := _pairs[3].IsActive AND _pairs[3].AllTrue;
safeRequested := monRequested AND NOT bypass;
FOR i := 1 TO 3 DO
    discError := discError OR _pairs[i].DiscrepancyError;
END_FOR
restartFalling := NOT Restart AND _restartPrev;
_restartPrev := Restart;

IF NOT FbRun AND _state <> E_SafeMonState.Error AND _state <> E_SafeMonState.Reset THEN
    _state := E_SafeMonState.Stop;
END_IF

// Discrepancy errors: immediate, except that a running delayed output completes its delay first
IF discError THEN
    CASE _state OF
        E_SafeMonState.Safe, E_SafeMonState.Start, E_SafeMonState.FuncTest:
            UpdateDiscrepancyDiag();
            _state := E_SafeMonState.Error;
        E_SafeMonState.Run:
            UpdateDiscrepancyDiag();
            IF Parameters.DelayTime > T#0S THEN
                _state := E_SafeMonState.ErrorDelay;
            ELSE
                _state := E_SafeMonState.Error;
            END_IF
        E_SafeMonState.DelayOut:
            UpdateDiscrepancyDiag();
            _state := E_SafeMonState.ErrorDelay;
    END_CASE
END_IF

passes := 0;
REPEAT
    stateBefore := _state;
    CASE _state OF
        E_SafeMonState.Stop:
            IF StateChanged() THEN
                SetOutputsSafe();
                Error := FALSE;
                Diag := 0;
                _delayRunning := FALSE;
                _funcTested[1] := FALSE;
                _funcTested[2] := FALSE;
            END_IF
            IF FbRun THEN
                functionTestDue := Parameters.ManualFunctionTest AND (_pairs[1].IsActive OR _pairs[2].IsActive);
                _state := SEL(functionTestDue, E_SafeMonState.Safe, E_SafeMonState.FuncTest);
            END_IF

        E_SafeMonState.FuncTest:
            // every connected MonIn pair must request the safe state once before a restart is accepted
            IF StateChanged() THEN
                SetOutputsSafe();
            END_IF
            IF _pairs[1].SafeStateRequested THEN
                _funcTested[1] := TRUE;
            END_IF
            IF _pairs[2].SafeStateRequested THEN
                _funcTested[2] := TRUE;
            END_IF
            IF (NOT _pairs[1].IsActive OR _funcTested[1]) AND (NOT _pairs[2].IsActive OR _funcTested[2]) THEN
                _state := E_SafeMonState.Safe;
            END_IF

        E_SafeMonState.Safe:
            IF StateChanged() THEN
                SetOutputsSafe();
                _delayRunning := FALSE;
            END_IF
            IF _restartConnected THEN
                IF Restart THEN
                    IF NOT EdmInputsOk() THEN
                        _state := E_SafeMonState.Error;
                    ELSIF NOT safeRequested THEN
                        _state := E_SafeMonState.Start;
                    END_IF
                END_IF
            ELSIF NOT safeRequested AND EdmInputsTrue() THEN
                // automatic restart: an EDM fault keeps the FB in SAFE without an error
                _state := E_SafeMonState.Run;
            END_IF

        E_SafeMonState.Start:
            IF StateChanged() THEN
                SetOutputsSafe();
            END_IF
            IF safeRequested THEN
                _state := E_SafeMonState.Safe;
            ELSIF restartFalling THEN
                IF EdmInputsOk() THEN
                    _state := E_SafeMonState.Run;
                ELSE
                    _state := E_SafeMonState.Error;
                END_IF
            END_IF

        E_SafeMonState.Run:
            IF StateChanged() THEN
                MonOut := TRUE;
                MonDelOut := TRUE;
                StartEdmResetMonitoring();
            END_IF
            IF NOT EdmResetOk() THEN
                _state := E_SafeMonState.Error;
            ELSIF safeRequested THEN
                IF Parameters.DelayTime > T#0S THEN
                    _state := E_SafeMonState.DelayOut;
                ELSE
                    _state := E_SafeMonState.Safe;
                END_IF
            END_IF

        E_SafeMonState.DelayOut:
            IF StateChanged() THEN
                MonOut := FALSE;
                MonDelOut := TRUE;
                _delayTimer(IN := FALSE, PT := Parameters.DelayTime);
                _delayRunning := TRUE;
            END_IF
            _delayTimer(IN := TRUE, PT := Parameters.DelayTime);
            IF _delayTimer.Q THEN
                _state := E_SafeMonState.Safe;
            END_IF

        E_SafeMonState.ErrorDelay:
            IF StateChanged() THEN
                MonOut := FALSE;
                MonDelOut := TRUE;
                IF NOT _delayRunning THEN
                    _delayTimer(IN := FALSE, PT := Parameters.DelayTime);
                    _delayRunning := TRUE;
                END_IF
            END_IF
            _delayTimer(IN := TRUE, PT := Parameters.DelayTime);
            IF _delayTimer.Q THEN
                _state := E_SafeMonState.Error;
            END_IF

        E_SafeMonState.Error:
            IF StateChanged() THEN
                SetOutputsSafe();
                Error := TRUE;
                _delayRunning := FALSE;
            END_IF
            UpdateDiscrepancyDiag();
            IF ErrAck AND NOT discError THEN
                _state := E_SafeMonState.Reset;
            END_IF

        E_SafeMonState.Reset:
            IF StateChanged() THEN
                SetOutputsSafe();
                Error := FALSE;
                Diag := 0;
            END_IF
            IF _errAckFallingEdge THEN
                _state := SEL(FbRun, E_SafeMonState.Stop, E_SafeMonState.Safe);
            END_IF
    END_CASE
    passes := passes + 1;
UNTIL (stateBefore = _state) OR (passes >= 3)
END_REPEAT

State := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateChanged" Id="{4f49d900-6c72-5edb-aae0-ac2250942590}">
      <Declaration><![CDATA[METHOD PRIVATE StateChanged : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _prevState = _state THEN
    RETURN;
END_IF
_prevState := _state;
StateChanged := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateDiscrepancyDiag" Id="{7365f059-79e2-59d3-b30a-a05a53bbf72e}">
      <Declaration><![CDATA[// Mirrors the discrepancy state of every pair into the diagnostic bits.
METHOD PRIVATE UpdateDiscrepancyDiag
VAR
    i : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
    IF _pairs[i].DiscrepancyError THEN
        SetDiagBit(i - 1);
        IF _pairs[i].AwaitingSafeInputs THEN
            SetDiagBit(i + 7);
        ELSE
            ClearDiagBit(i + 7);
        END_IF
    END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EdmInputsTrue" Id="{8cb42dfd-368f-58c8-9d89-fb06fe8dfe32}">
      <Declaration><![CDATA[// TRUE when every connected EDM input reads 1 (contactors released).
METHOD PRIVATE EdmInputsTrue : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[EdmInputsTrue := (NOT _eDM1Connected OR EDM1) AND (NOT _eDM2Connected OR EDM2);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EdmInputsOk" Id="{1b103a2b-707f-5b03-a929-899cb09b3bd2}">
      <Declaration><![CDATA[// Checks the EDM inputs at restart and records diagnostic bits 4/5 on failure.
METHOD PRIVATE EdmInputsOk : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[EdmInputsOk := TRUE;
IF _eDM1Connected AND NOT EDM1 THEN
    SetDiagBit(4);
    EdmInputsOk := FALSE;
END_IF
IF _eDM2Connected AND NOT EDM2 THEN
    SetDiagBit(5);
    EdmInputsOk := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EdmResetOk" Id="{35c1dcfd-9f7d-5aa9-8267-72e9532ea95e}">
      <Declaration><![CDATA[// EL6910 extension: after the outputs switch on, each connected EDM input must drop to FALSE
// within its Reset Time. Returns FALSE (and sets diagnostic bits 4/5) on timeout.
METHOD PRIVATE EdmResetOk : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[EdmResetOk := TRUE;
IF _eDM1Connected AND Parameters.Edm1ResetTime > T#0S THEN
    IF NOT EDM1 THEN
        _edm1Dropped := TRUE;
    END_IF
    _edmResetTimer1(IN := NOT _edm1Dropped, PT := Parameters.Edm1ResetTime);
    IF _edmResetTimer1.Q THEN
        SetDiagBit(4);
        EdmResetOk := FALSE;
    END_IF
END_IF
IF _eDM2Connected AND Parameters.Edm2ResetTime > T#0S THEN
    IF NOT EDM2 THEN
        _edm2Dropped := TRUE;
    END_IF
    _edmResetTimer2(IN := NOT _edm2Dropped, PT := Parameters.Edm2ResetTime);
    IF _edmResetTimer2.Q THEN
        SetDiagBit(5);
        EdmResetOk := FALSE;
    END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartEdmResetMonitoring" Id="{6a5ef06f-41c1-5fa1-8d07-b1f19dfdeae7}">
      <Declaration><![CDATA[METHOD PRIVATE StartEdmResetMonitoring
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_edm1Dropped := FALSE;
_edm2Dropped := FALSE;
_edmResetTimer1(IN := FALSE, PT := Parameters.Edm1ResetTime);
_edmResetTimer2(IN := FALSE, PT := Parameters.Edm2ResetTime);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOutputsSafe" Id="{d6b71cdb-10cb-5cef-8ab8-fab8d59e96fb}">
      <Declaration><![CDATA[METHOD PRIVATE SetOutputsSafe
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MonOut := FALSE;
MonDelOut := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="MonState" Id="{769a4cb9-6d70-5570-a0e7-7efd6c97fd1a}">
      <Declaration><![CDATA[PROPERTY MonState : E_SafeMonState
]]></Declaration>
      <Get Name="Get" Id="{95bc0708-06e3-53fd-94ba-eae44211a889}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MonState := _state;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
