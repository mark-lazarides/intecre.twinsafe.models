<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="T_SafeEdm" Id="{94513746-5a4a-593d-9559-f1f6e17d8ef6}" SpecialFunc="None">
    <Declaration><![CDATA[// Model of the TwinSAFE FB EDM (external device monitor):
// Mon2 must take the opposite value to Mon1 within the configured switch-on / switch-off time.
{attribute 'reflection'}
FUNCTION_BLOCK T_SafeEdm EXTENDS T_SafeFunctionBlockBase
VAR_INPUT
    Mon1       : BOOL;
    Mon2       : BOOL;
    Parameters : ST_SafeEdmParameters;
END_VAR
VAR
    {attribute 'is_connected' := 'Mon1'}
    _mon1Connected         : BOOL;
    {attribute 'is_connected' := 'Mon2'}
    _mon2Connected         : BOOL;
    _state     : E_SafeEdmState := E_SafeEdmState.Stop;
    _prevState : E_SafeEdmState;
    _timer     : TON;
    _satisfied : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
IsRunning := (_state = E_SafeEdmState.MonOn) OR (_state = E_SafeEdmState.MonOff);
]]></ST>
    </Implementation>
    <Method Name="Process" Id="{3cdf0347-8054-5d03-b684-c97c45933410}">
      <Declaration><![CDATA[METHOD PROTECTED Process
VAR
    monitor1 : BOOL;
    monitor2 : BOOL;
    stateBefore : E_SafeEdmState;
    passes      : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[monitor1 := F_SafeInputValue(_mon1Connected, Parameters.Mon1MakeContact, Mon1);
monitor2 := F_SafeInputValue(_mon2Connected, Parameters.Mon2MakeContact, Mon2);

IF NOT FbRun AND _state <> E_SafeEdmState.Error AND _state <> E_SafeEdmState.Reset THEN
    _state := E_SafeEdmState.Stop;
END_IF

passes := 0;
REPEAT
    stateBefore := _state;
    CASE _state OF
        E_SafeEdmState.Stop:
            IF StateChanged() THEN
                Error := FALSE;
                Diag := 0;
                _timer(IN := FALSE, PT := T#0S);
            END_IF
            IF FbRun THEN
                _state := SEL(monitor1, E_SafeEdmState.MonOff, E_SafeEdmState.MonOn);
            END_IF

        E_SafeEdmState.MonOn:
            // switch-on monitoring: Mon2 must become FALSE within SwitchOnTime
            IF StateChanged() THEN
                _satisfied := FALSE;
                _timer(IN := FALSE, PT := Parameters.SwitchOnTime);
            END_IF
            IF NOT monitor2 THEN
                _satisfied := TRUE;
            END_IF
            _timer(IN := NOT _satisfied AND (Parameters.SwitchOnTime > T#0S), PT := Parameters.SwitchOnTime);
            IF _timer.Q THEN
                SetDiagBit(1);
                _state := E_SafeEdmState.Error;
            ELSIF NOT monitor1 THEN
                _state := E_SafeEdmState.MonOff;
            END_IF

        E_SafeEdmState.MonOff:
            // switch-off monitoring: Mon2 must become TRUE within SwitchOffTime
            IF StateChanged() THEN
                _satisfied := FALSE;
                _timer(IN := FALSE, PT := Parameters.SwitchOffTime);
            END_IF
            IF monitor2 THEN
                _satisfied := TRUE;
            END_IF
            _timer(IN := NOT _satisfied AND (Parameters.SwitchOffTime > T#0S), PT := Parameters.SwitchOffTime);
            IF _timer.Q THEN
                SetDiagBit(0);
                _state := E_SafeEdmState.Error;
            ELSIF monitor1 THEN
                _state := E_SafeEdmState.MonOn;
            END_IF

        E_SafeEdmState.Error:
            IF StateChanged() THEN
                Error := TRUE;
                _timer(IN := FALSE, PT := T#0S);
            END_IF
            IF ErrAck THEN
                _state := E_SafeEdmState.Reset;
            END_IF

        E_SafeEdmState.Reset:
            IF StateChanged() THEN
                Error := FALSE;
                Diag := 0;
            END_IF
            IF _errAckFallingEdge THEN
                IF NOT FbRun THEN
                    _state := E_SafeEdmState.Stop;
                ELSE
                    _state := SEL(monitor1, E_SafeEdmState.MonOff, E_SafeEdmState.MonOn);
                END_IF
            END_IF
    END_CASE
    passes := passes + 1;
UNTIL (stateBefore = _state) OR (passes >= 3)
END_REPEAT

State := TO_BYTE(_state);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateChanged" Id="{e5e1a74f-db89-51eb-8b5c-0f7e2fec9c12}">
      <Declaration><![CDATA[METHOD PRIVATE StateChanged : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _prevState = _state THEN
    RETURN;
END_IF
_prevState := _state;
StateChanged := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
