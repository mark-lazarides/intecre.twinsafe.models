<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <POU Name="PRG_EStopExample" Id="{3a0a9fad-17d0-565d-84a6-eead2cf474e2}" SpecialFunc="None">
    <Declaration><![CDATA[// Worked example: a two-channel emergency stop with contactor feedback, wired the way a
// TwinSAFE project links it, plus the standard PLC signals (Run, ErrAck, Restart).
// Toggle the "field" variables online to trial the behaviour.
PROGRAM PRG_EStopExample
VAR
    // --- simulated field devices (real hardware in a TwinSAFE system)
    eStopChannel1     : BOOL := TRUE;   // NC contact, TRUE = not pressed
    eStopChannel2     : BOOL := TRUE;
    contactorFeedback : BOOL := TRUE;   // NC auxiliary contact, TRUE = contactors released

    // --- standard PLC interface to the TwinSAFE group (linked to standard variables)
    safetyRun     : BOOL := TRUE;
    safetyErrAck  : BOOL;
    restartButton : BOOL;               // 0 -> 1 -> 0 to restart
    groupState    : BYTE;
    groupDiag     : BYTE;
    eStopState    : BYTE;
    eStopDiag     : WORD;

    // --- TwinSAFE model (parameters as set in the Safety Editor property grid)
    group          : T_SafeGroup;
    inputTerminal  : T_SafeInputTerminal;    // EL1904
    outputTerminal : T_SafeOutputTerminal;   // EL2904
    eStop          : T_SafeEStop := (Parameters := (DiscrepancyTime1 := T#500MS, DelayTime := T#1S));

    // --- simulated contactors: pull in 50 ms after the safe output energises
    contactorPullIn : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Field -> safe input terminal (its FSoE connection belongs to the group)
inputTerminal(
    Channel1 := eStopChannel1,
    Channel2 := eStopChannel2,
    GroupRun := safetyRun,
    ErrAck := safetyErrAck);

// TwinSAFE group: standard PLC signals in, FB and connection states fed back
group(
    Run := safetyRun,
    ErrAck := safetyErrAck,
    AnyFbError := eStop.Error,
    AllFbsRunning := eStop.IsRunning,
    AnyComError := inputTerminal.ComError OR outputTerminal.ComError,
    AnyComStartup := inputTerminal.InStartup OR outputTerminal.InStartup);

// FB ESTOP wired as in the safety project: EStopIn1/2 two channel, EDM1 and Restart from standard signals
eStop(
    FbRun := group.InRun,
    ErrAck := safetyErrAck,
    Restart := restartButton,
    EDM1 := contactorFeedback,
    EStopIn1 := inputTerminal.SafeIn1,
    EStopIn2 := inputTerminal.SafeIn2);

// Safe outputs -> output terminal -> field
outputTerminal(
    SafeOut1 := eStop.EStopOut,
    SafeOut2 := eStop.EStopDelOut,
    GroupRun := safetyRun,
    ErrAck := safetyErrAck);

// Simulated contactor feedback loop
contactorPullIn(IN := outputTerminal.Channel1, PT := T#50MS);
contactorFeedback := NOT contactorPullIn.Q;

// Info data as the standard PLC would see it
groupState := group.State;
groupDiag := group.Diag;
eStopState := eStop.State;
eStopDiag := eStop.Diag;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
