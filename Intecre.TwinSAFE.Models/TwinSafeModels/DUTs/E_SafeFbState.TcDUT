<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <DUT Name="E_SafeFbState" Id="{5d9e015e-1809-5153-8717-63aca5596788}">
    <Declaration><![CDATA[// TwinSAFE function block state codes shared by most FBs (Map State value).
{attribute 'qualified_only'}
{attribute 'to_string'}
TYPE E_SafeFbState :
(
    Undefined    := 0,
    Run          := 1,
    Stop         := 2,
    Safe         := 3,
    Error        := 4,
    Reset        := 5,
    Start        := 6,
    ErrorDelay   := 7,
    DelayOut     := 8
) BYTE;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
