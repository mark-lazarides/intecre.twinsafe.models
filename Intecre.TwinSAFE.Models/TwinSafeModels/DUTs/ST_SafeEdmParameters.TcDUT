  <DUT Name="ST_SafeEdmParameters" Id="{9f35ddac-978d-5d75-b57a-ce41fefc2f5d}">
    <Declaration><![CDATA[// Parameters of FB EDM.
TYPE ST_SafeEdmParameters :
STRUCT
    Mon1MakeContact : BOOL;
    Mon2MakeContact : BOOL;
    SwitchOnTime    : TIME;   // Mon2 must become FALSE within this time of Mon1 rising. T#0S disables
    SwitchOffTime   : TIME;   // Mon2 must become TRUE within this time of Mon1 falling. T#0S disables
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
