<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.22">
  <DUT Name="ST_SafeTwoHandParameters" Id="{b88544d9-b726-539b-a312-7f8941f8befd}">
    <Declaration><![CDATA[// Parameters of FB TWOHAND.
TYPE ST_SafeTwoHandParameters :
STRUCT
    Twohand1MakeContact      : BOOL;
    Twohand2MakeContact      : BOOL;
    Twohand3MakeContact      : BOOL;
    Twohand4MakeContact      : BOOL;
    DiscrepancyTime1         : TIME;   // Twohand1 / Twohand2
    DiscrepancyTime2         : TIME;   // Twohand3 / Twohand4
    HandDiscrepancyTime      : TIME;   // max time between actuation of the two hands (max 2500 ms). T#0S disables
    SafeInputsAfterDiscError : BOOL := TRUE;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
