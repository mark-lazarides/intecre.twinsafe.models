  <DUT Name="E_SafeConnectionState" Id="{1e2df103-742e-5c1c-95e1-1476ae6532eb}">
    <Declaration><![CDATA[// TwinSAFE (FSoE) connection state codes.
{attribute 'qualified_only'}
{attribute 'to_string'}
TYPE E_SafeConnectionState :
(
    Reset        := 100,
    Session      := 101,
    Connection   := 102,
    Parameter    := 103,
    Data         := 104,
    Shutdown     := 105,
    ShutdownDeactive := 106
) BYTE;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
