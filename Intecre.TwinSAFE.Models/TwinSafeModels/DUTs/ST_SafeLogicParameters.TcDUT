  <DUT Name="ST_SafeLogicParameters" Id="{54b713a6-7cd6-5c0b-8822-198b81c20625}">
    <Declaration><![CDATA[// Parameters of FB AND and FB OR. Inputs are active when connected.
TYPE ST_SafeLogicParameters :
STRUCT
    In1MakeContact : BOOL;   // TRUE = the input is negated before the logic operation
    In2MakeContact : BOOL;
    In3MakeContact : BOOL;
    In4MakeContact : BOOL;
    In5MakeContact : BOOL;
    In6MakeContact : BOOL;
    In7MakeContact : BOOL;
    In8MakeContact : BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
